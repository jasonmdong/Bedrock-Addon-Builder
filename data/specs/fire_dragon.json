  "animation_controller_json": {
    "format_version": "1.10.0",
    "animation_controllers": {
      "controller.animation.my_first_mob": {
        "initial_state": "idle",
        "states": {
          "idle": {
            "animations": [
              "animation.custom_dragon.idle",
              {
                "animation.custom_dragon.attack": "(variable.attack_time > 0) || (variable.attacking > 0)"
              }
            ],
            "transitions": [
              {
                "flying": "!query.is_on_ground"
              },
              {
                "idle": "!query.is_moving && query.is_on_ground"
              }
            ]
          },
          "flying": {
            "animations": [
              "animation.custom_dragon.fly",
              {
                "animation.custom_dragon.attack": "(variable.attack_time > 0) || (variable.attacking > 0)"
              }
            ],
            "transitions": [
              {
                "idle": "query.is_on_ground && !query.is_moving"
              },
              {
                "flying": "!query.is_on_ground"
              }
            ]
          }
        }
      }
    }
