# Get a GitHub PAT at https://github.com/settings/tokens
# Required permission: models:read
GITHUB_TOKEN=ghp_your_token_here

# Optional: set one model for all tools
MOB_FORGE_MODEL=gpt-4o-mini

# Optional: override per tool
MOB_FORGE_MOB_MODEL=gpt-4o-mini
MOB_FORGE_GEOMETRY_MODEL=gpt-4o-mini
MOB_FORGE_TEXTURE_MODEL=gpt-4o-mini
