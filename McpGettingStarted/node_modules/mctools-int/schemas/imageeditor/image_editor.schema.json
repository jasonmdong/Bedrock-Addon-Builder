{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/imageeditor/image_editor.form.json",
  "title": "Image Editor",
  "description": "Defines image editor settings for creating textures and paintings.",
  "type": "object",
  "properties": {
    "width": {
      "title": "Width",
      "type": "integer"
    },
    "height": {
      "title": "Height",
      "type": "integer"
    },
    "outputs": {
      "title": "Outputs",
      "description": "\n\nProperties:\n• name (string)\n• type\n• paintingOverrideName (enum)\n• paintingSize (enum)",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "title": "Name",
            "description": "Name of the block",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "description": "Type of fun thing you want to create from this image.",
            "type": "integer",
            "enum": [
              1,
              2,
              3,
              11,
              12,
              13
            ]
          },
          "paintingOverrideName": {
            "title": "Override Painting",
            "type": "string",
            "enum": [
              "backyard",
              "baroque",
              "bouquet",
              "cavebird",
              "changing",
              "cotan",
              "meditative"
            ]
          },
          "paintingSize": {
            "title": "Painting Size",
            "type": "string",
            "enum": [
              1,
              3,
              5
            ]
          }
        }
      }
    }
  }
}