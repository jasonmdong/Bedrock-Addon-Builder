{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/3.0.0/togglesetting.form.json",
  "title": "3.0.0.ToggleSetting",
  "description": "A boolean on/off setting that appears in the pack's world settings UI. Players can toggle features like 'Enable Hard Mode' or 'Show Tutorials' before entering a world. Scripts can read these values at runtime.",
  "type": "object",
  "properties": {
    "default": {
      "title": "Default",
      "type": "boolean"
    },
    "name": {
      "title": "Name",
      "type": "string",
      "pattern": "^(?:(?!^(minecraft):).)+:(?:.)+$"
    },
    "text": {
      "title": "Text",
      "type": "string"
    },
    "type": {
      "title": "SettingType",
      "type": "string",
      "enum": [
        "dropdown",
        "label",
        "slider",
        "toggle"
      ]
    }
  },
  "required": [
    "default",
    "name",
    "text",
    "type"
  ]
}