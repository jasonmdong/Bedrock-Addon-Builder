{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/3.0.0/packdependency.form.json",
  "title": "3.0.0.PackDependency",
  "description": "References another add-on pack that must be present for this pack to work. Commonly used to link a behavior pack to its companion resource pack, or to depend on shared library packs. Uses UUID and version matching.",
  "type": "object",
  "properties": {
    "uuid": {
      "title": "Uuid",
      "type": "object",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "version": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "buildMeta": {
              "title": "BuildMeta",
              "type": "string",
              "default": ""
            },
            "major": {
              "title": "Major",
              "type": "integer",
              "default": 0
            },
            "minor": {
              "title": "Minor",
              "type": "integer",
              "default": 0
            },
            "patch": {
              "title": "Patch",
              "type": "integer",
              "default": 0
            },
            "preRelease": {
              "title": "PreRelease",
              "type": "string",
              "default": ""
            }
          }
        },
        {
          "type": "string"
        }
      ],
      "description": "\n\nProperties:\n• buildMeta (string) = \n• major (int) = 0\n• minor (int) = 0\n• patch (int) = 0\n• preRelease (string) = "
    }
  },
  "required": [
    "uuid",
    "version"
  ]
}