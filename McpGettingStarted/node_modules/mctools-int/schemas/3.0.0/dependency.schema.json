{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/3.0.0/dependency.form.json",
  "title": "3.0.0.Dependency",
  "description": "Declares that this pack requires another pack or native module to function. Dependencies can reference other add-ons by UUID/version or native Script API modules like '@minecraft/server'. Minecraft ensures dependencies are loaded first.",
  "type": "object",
  "properties": {
    "module_name": {
      "title": "Module Name",
      "type": "string"
    },
    "uuid": {
      "title": "Uuid",
      "type": "object",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "version": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "buildMeta": {
              "title": "BuildMeta",
              "type": "string"
            },
            "major": {
              "title": "Major",
              "type": "integer"
            },
            "minor": {
              "title": "Minor",
              "type": "integer"
            },
            "patch": {
              "title": "Patch",
              "type": "integer"
            },
            "preRelease": {
              "title": "PreRelease",
              "type": "string"
            }
          }
        },
        {
          "type": "string"
        }
      ],
      "description": "\n\nProperties:\n• buildMeta (string)\n• major (int)\n• minor (int)\n• patch (int)\n• preRelease (string)"
    }
  },
  "required": [
    "version"
  ]
}