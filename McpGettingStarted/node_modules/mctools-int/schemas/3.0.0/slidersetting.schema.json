{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/3.0.0/slidersetting.form.json",
  "title": "3.0.0.SliderSetting",
  "description": "A numeric slider setting that appears in the pack's world settings UI. Allows players to adjust values like 'Difficulty Multiplier' or 'Spawn Rate' within defined min/max bounds. Scripts can read the chosen value at runtime.",
  "type": "object",
  "properties": {
    "default": {
      "title": "Default",
      "type": "number"
    },
    "max": {
      "title": "Max",
      "type": "number"
    },
    "min": {
      "title": "Min",
      "type": "number"
    },
    "name": {
      "title": "Name",
      "type": "string",
      "pattern": "^(?:(?!^(minecraft):).)+:(?:.)+$"
    },
    "step": {
      "title": "Step",
      "type": "number",
      "exclusiveMinimum": 0
    },
    "text": {
      "title": "Text",
      "type": "string"
    },
    "type": {
      "title": "SettingType",
      "type": "string",
      "enum": [
        "dropdown",
        "label",
        "slider",
        "toggle"
      ]
    }
  },
  "required": [
    "default",
    "max",
    "min",
    "name",
    "step",
    "text",
    "type"
  ]
}