{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/3.0.0/header.form.json",
  "title": "3.0.0.Header",
  "description": "The header section of manifest.json containing the pack's identity: its name shown in the UI, description, unique UUID, and version. The min_engine_version field specifies the minimum Minecraft version required to load the pack.",
  "type": "object",
  "properties": {
    "allow_random_seed": {
      "title": "Allow Random Seed",
      "type": "boolean"
    },
    "base_game_version": {
      "title": "Base Game Version",
      "type": "string"
    },
    "description": {
      "title": "Description",
      "type": "string"
    },
    "lock_template_options": {
      "title": "Lock Template Options",
      "type": "boolean"
    },
    "min_engine_version": {
      "title": "Min Engine Version",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "pack_optimization_version": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "buildMeta": {
              "title": "BuildMeta",
              "type": "string",
              "default": ""
            },
            "major": {
              "title": "Major",
              "type": "integer",
              "default": 0
            },
            "minor": {
              "title": "Minor",
              "type": "integer",
              "default": 0
            },
            "patch": {
              "title": "Patch",
              "type": "integer",
              "default": 0
            },
            "preRelease": {
              "title": "PreRelease",
              "type": "string",
              "default": ""
            }
          }
        },
        {
          "type": "string"
        }
      ],
      "description": "\n\nProperties:\n• buildMeta (string) = \n• major (int) = 0\n• minor (int) = 0\n• patch (int) = 0\n• preRelease (string) = "
    },
    "pack_scope": {
      "title": "Pack Scope",
      "type": "string"
    },
    "platform_locked": {
      "title": "Platform Locked",
      "type": "boolean"
    },
    "uuid": {
      "title": "Uuid",
      "type": "object",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "version": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "buildMeta": {
              "title": "BuildMeta",
              "type": "string",
              "default": ""
            },
            "major": {
              "title": "Major",
              "type": "integer",
              "default": 0
            },
            "minor": {
              "title": "Minor",
              "type": "integer",
              "default": 0
            },
            "patch": {
              "title": "Patch",
              "type": "integer",
              "default": 0
            },
            "preRelease": {
              "title": "PreRelease",
              "type": "string",
              "default": ""
            }
          }
        },
        {
          "type": "string"
        }
      ],
      "description": "\n\nProperties:\n• buildMeta (string) = \n• major (int) = 0\n• minor (int) = 0\n• patch (int) = 0\n• preRelease (string) = "
    }
  },
  "required": [
    "name",
    "uuid",
    "version"
  ]
}