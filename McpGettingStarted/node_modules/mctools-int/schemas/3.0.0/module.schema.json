{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/3.0.0/module.form.json",
  "title": "3.0.0.Module",
  "description": "Declares a module within the pack. Modules define what the pack contains: 'data' for behavior packs, 'resources' for resource packs, or 'script' for packs with JavaScript/TypeScript code. Script modules require an entry point file path.",
  "type": "object",
  "properties": {
    "description": {
      "title": "Description",
      "type": "string"
    },
    "entry": {
      "title": "Entry",
      "type": "string"
    },
    "language": {
      "title": "Language",
      "type": "string"
    },
    "type": {
      "title": "Type",
      "type": "string"
    },
    "uuid": {
      "title": "Uuid",
      "type": "object",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "version": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "buildMeta": {
              "title": "BuildMeta",
              "type": "string",
              "default": ""
            },
            "major": {
              "title": "Major",
              "type": "integer",
              "default": 0
            },
            "minor": {
              "title": "Minor",
              "type": "integer",
              "default": 0
            },
            "patch": {
              "title": "Patch",
              "type": "integer",
              "default": 0
            },
            "preRelease": {
              "title": "PreRelease",
              "type": "string",
              "default": ""
            }
          }
        },
        {
          "type": "string"
        }
      ],
      "description": "\n\nProperties:\n• buildMeta (string) = \n• major (int) = 0\n• minor (int) = 0\n• patch (int) = 0\n• preRelease (string) = "
    }
  },
  "required": [
    "type",
    "uuid",
    "version"
  ]
}