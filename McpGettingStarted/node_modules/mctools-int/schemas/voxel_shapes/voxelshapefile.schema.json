{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/voxel_shapes/voxelshapefile.form.json",
  "title": "Voxel Shapes VoxelShapeFile",
  "description": "Defines a complete voxel shape file.",
  "type": "object",
  "properties": {
    "description": {
      "title": "Description",
      "description": "\n\nProperties:\n• identifier (object)",
      "$ref": "#/$defs/voxel_shapes_description",
      "defaultSnippets": [
        {
          "label": "Voxel Shapes Description",
          "description": "Defines voxel shape identifier.",
          "body": {
            "identifier": ""
          }
        }
      ]
    },
    "shape": {
      "title": "Shape",
      "description": "\n\nProperties:\n• boxes (object) [maxLen: 32]",
      "$ref": "#/$defs/voxel_shapes_shape",
      "defaultSnippets": [
        {
          "label": "Voxel Shapes Shape",
          "description": "Defines a voxel shape with boxes.",
          "body": {
            "boxes": ""
          }
        }
      ]
    }
  },
  "required": [
    "description",
    "shape"
  ],
  "$defs": {
    "voxel_shapes_description": {
      "type": "object",
      "title": "Voxel Shapes Description",
      "description": "Defines voxel shape identifier.",
      "properties": {
        "identifier": {
          "title": "Identifier",
          "type": "object"
        }
      },
      "required": [
        "identifier"
      ]
    },
    "voxel_shapes_box": {
      "type": "object",
      "title": "Voxel Shapes Box",
      "description": "Defines a bounding box with min and max coordinates.",
      "properties": {
        "max": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            {
              "description": "\n\nProperties:\n• x (float) = 0\n• y (float) = 0\n• z (float) = 0",
              "type": "object",
              "properties": {
                "x": {
                  "title": "X",
                  "type": "number",
                  "default": 0
                },
                "y": {
                  "title": "Y",
                  "type": "number",
                  "default": 0
                },
                "z": {
                  "title": "Z",
                  "type": "number",
                  "default": 0
                }
              },
              "defaultSnippets": [
                {
                  "label": "Max (object)",
                  "description": "Use Max as an object",
                  "body": {
                    "x": 0,
                    "y": 0,
                    "z": 0
                  }
                }
              ]
            }
          ],
          "title": "Max",
          "defaultSnippets": [
            {
              "label": "Max (object)",
              "description": "Use Max as an object",
              "body": {
                "x": 0,
                "y": 0,
                "z": 0
              }
            }
          ]
        },
        "min": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            {
              "description": "\n\nProperties:\n• x (float) = 0\n• y (float) = 0\n• z (float) = 0",
              "type": "object",
              "properties": {
                "x": {
                  "title": "X",
                  "type": "number",
                  "default": 0
                },
                "y": {
                  "title": "Y",
                  "type": "number",
                  "default": 0
                },
                "z": {
                  "title": "Z",
                  "type": "number",
                  "default": 0
                }
              },
              "defaultSnippets": [
                {
                  "label": "Min (object)",
                  "description": "Use Min as an object",
                  "body": {
                    "x": 0,
                    "y": 0,
                    "z": 0
                  }
                }
              ]
            }
          ],
          "title": "Min",
          "defaultSnippets": [
            {
              "label": "Min (object)",
              "description": "Use Min as an object",
              "body": {
                "x": 0,
                "y": 0,
                "z": 0
              }
            }
          ]
        }
      },
      "required": [
        "max",
        "min"
      ]
    },
    "voxel_shapes_shape": {
      "type": "object",
      "title": "Voxel Shapes Shape",
      "description": "Defines a voxel shape with boxes.",
      "properties": {
        "boxes": {
          "title": "Boxes",
          "description": "\n\nProperties:\n• max\n• min",
          "$ref": "#/$defs/voxel_shapes_box",
          "defaultSnippets": [
            {
              "label": "Voxel Shapes Box",
              "description": "Defines a bounding box with min and max coordinates.",
              "body": {
                "max": "",
                "min": ""
              }
            }
          ],
          "minLength": 1,
          "maxLength": 32
        }
      },
      "required": [
        "boxes"
      ]
    }
  }
}