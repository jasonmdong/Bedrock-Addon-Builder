{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/visual/block_reference.v1.10.0.form.json",
  "title": "Block Reference (v1.10.0)",
  "description": "Defines a block reference object as used by resource pack client definitions (format_version 1.10.0).",
  "type": "object",
  "properties": {
    "name": {
      "title": "Name",
      "type": "string"
    },
    "states": {
      "title": "States",
      "description": "\n\nProperties:\n• \\w*:?\\w+ (int)",
      "type": "object",
      "properties": {
        "\\w*:?\\w+": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "boolean"
            },
            {
              "type": "string"
            }
          ],
          "title": "\\w* ?\\w+"
        }
      },
      "defaultSnippets": [
        {
          "label": "States",
          "description": "Create a States",
          "body": {
            "\\w*:?\\w+": 0
          }
        }
      ]
    }
  },
  "required": [
    "name",
    "states"
  ]
}