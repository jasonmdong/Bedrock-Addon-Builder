    "minecraft:client_entity": {
      "title": "Client Entity",
      "description": "Defines the client-side rendering properties for an entity, including textures, geometry, animations, and render controllers.\n\nProperties:\n• description ({ identifier, min_engine_version, materials, ... })",
      "type": "object",
      "properties": {
        "description": {
          "title": "Description",
          "description": "Contains all the visual definition properties for this entity, including identifier, textures, geometry, materials, animations, and spawn egg settings.\n\nProperties:\n• identifier (string)\n• min_engine_version\n• materials (object)\n• textures (object)\n• geometry (object)\n• queryable_geometry (string)\n• spawn_egg ({ texture, base_color, overlay_color, ... })\n• scripts ({ variables, initialize, pre_animation, ... })\n• ... and 8 more properties",
          "type": "object",
          "properties": {
            "identifier": {
              "title": "Identifier",
              "description": "The namespaced identifier for this entity (e.g., 'minecraft:pig' or 'mypack:custom_mob'). Must match the behavior pack entity identifier.",
              "type": "string"
            },
            "min_engine_version": {
              "title": "Min Engine Version",
              "description": "The minimum Minecraft engine version required to render this entity. Used for forward compatibility.",
              "type": "string"
            },
            "materials": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {}
                },
                {
                  "title": "<identifier>",
                  "type": "string"
                }
              ],
              "title": "Materials",
              "description": "Maps short names to material definitions that control how the entity is rendered. Common materials include 'entity', 'entity_alphatest', and 'entity_emissive'."
            },
            "textures": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {}
                },
                {
                  "title": "<identifier>",
                  "type": "string"
                }
              ],
              "title": "Textures",
              "description": "Maps short names to texture file paths. Paths are relative to the resource pack root (e.g., 'textures/entity/pig/pig'). The short name is used in render controllers."
            },
            "geometry": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {}
                },
                {
                  "title": "<identifier>",
                  "type": "string"
                }
              ],
              "title": "Geometry",
              "description": "Maps short names to geometry model identifiers. Geometry defines the 3D shape and bone structure of the entity. Models are defined in .geo.json files."
            },
            "queryable_geometry": {
              "title": "Queryable Geometry",
              "description": "Specifies which geometry is queryable via Molang expressions. Used for ray casting and spatial queries in scripts.",
              "type": "string"
            },
            "spawn_egg": {
              "title": "Spawn Egg",
              "description": "Defines the appearance of the spawn egg for this entity in the creative inventory.\n\nProperties:\n• texture (string)\n• base_color (string)\n• overlay_color (string)\n• texture_index (int)",
              "type": "object",
              "properties": {
                "texture": {
                  "title": "Texture",
                  "type": "string"
                },
                "base_color": {
                  "title": "Base Color",
                  "type": "string"
                },
                "overlay_color": {
                  "title": "Overlay Color",
                  "type": "string"
                },
                "texture_index": {
                  "title": "Texture Index",
                  "type": "integer"
                }
              },
              "defaultSnippets": [
