{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/client_biome/minecraft_sky_color.form.json",
  "title": "Minecraft Sky Color",
  "description": "Sets the sky color used during rendering. Biomes without this component will have default sky color behavior.",
  "type": "object",
  "properties": {
    "sky_color": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minLength": 3,
          "maxLength": 3
        }
      ],
      "title": "Sky Color",
      "description": "RGB color of the sky"
    }
  },
  "required": [
    "sky_color"
  ]
}