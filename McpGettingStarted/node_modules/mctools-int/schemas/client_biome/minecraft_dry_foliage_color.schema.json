{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/client_biome/minecraft_dry_foliage_color.form.json",
  "title": "Client Biome Dry Foliage Color",
  "description": "Set the dry foliage color used during rendering. Biomes without this component will have default dry foliage color behavior.",
  "type": "object",
  "properties": {
    "color": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minLength": 3,
          "maxLength": 3
        }
      ],
      "title": "Color",
      "description": "RGB color of dry foliage"
    }
  },
  "required": [
    "color"
  ]
}