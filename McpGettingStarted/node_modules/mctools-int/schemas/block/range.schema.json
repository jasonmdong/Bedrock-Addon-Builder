{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/block/range.form.json",
  "title": "Block Range",
  "description": "Define a range of integer value using a \"min\" and \"max\" limit and must be assigned to \"values\"",
  "type": "object",
  "properties": {
    "max": {
      "title": "Max",
      "type": "integer"
    },
    "min": {
      "title": "Min",
      "type": "integer"
    }
  },
  "required": [
    "max",
    "min"
  ]
}