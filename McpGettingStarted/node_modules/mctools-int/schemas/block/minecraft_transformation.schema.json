{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/block/minecraft_transformation.form.json",
  "title": "Transformation",
  "description": "The block's translation, rotation and scale with respect to the center of its world position",
  "type": "object",
  "properties": {
    "rotation": {
      "title": "Rotation",
      "description": "The block's rotation in increments of 90 degrees",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rotation_pivot": {
      "title": "Rotation Pivot",
      "description": "The point to apply rotation around",
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "scale": {
      "title": "Scale",
      "description": "The block's scale",
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "scale_pivot": {
      "title": "Scale Pivot",
      "description": "The point to apply scale around",
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "translation": {
      "title": "Translation",
      "description": "The block's translation",
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    }
  }
}