{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/dev/package_json.form.json",
  "title": "Package.json",
  "description": "Defines the structure of a Node.js package.json file.",
  "type": "object",
  "properties": {
    "name": {
      "title": "Name",
      "type": "string"
    },
    "productName": {
      "title": "Product Name",
      "type": "string"
    },
    "main": {
      "title": "Main Entrypoint",
      "type": "string"
    },
    "homepage": {
      "title": "Homepage",
      "type": "string"
    },
    "icon": {
      "title": "Icon",
      "type": "string"
    },
    "private": {
      "title": "Private",
      "type": "boolean"
    },
    "description": {
      "title": "Description",
      "type": "string"
    },
    "version": {
      "title": "Version",
      "type": "string"
    }
  }
}