        }
      }
    },
    "info_set_item": {
      "type": "object",
      "title": "Info Set Item",
      "description": "Single entry from the generator output feed.",
      "properties": {
        "iTp": {
          "title": "Item Type",
          "description": "Numeric discriminator identifying the kind of item entry.",
          "type": "integer"
        },
        "gId": {
          "title": "Group Id",
          "description": "Identifier of the generator group responsible for this entry.",
          "type": "string"
        },
        "gIx": {
          "title": "Group Index",
          "description": "Requirement or message code as emitted by the generator.",
          "type": "integer"
        },
        "p": {
          "title": "Path",
          "description": "Optional path that contextualises the item entry.",
          "type": "string"
        },
        "d": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "description": "Numeric tuple representation when the generator emits version triples or coordinates.",
              "type": "array",
              "items": {
                "type": "number"
              }
            }
          ],
          "title": "Data",
          "description": "Supplemental data emitted with the item. Can be a string or an array of numbers."
        },
        "m": {
          "title": "Message",
          "description": "Human readable context for the entry.",
          "type": "string"
        },
        "fs": {
          "title": "Feature Sets",
          "description": "Optional keyed metrics attached to this item entry.\n\nProperties:\n• count (int)",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/info_set_feature_set_entry"
          }
        }
      },
      "required": [
        "iTp",
        "gId",
        "gIx"
      ]
    },
