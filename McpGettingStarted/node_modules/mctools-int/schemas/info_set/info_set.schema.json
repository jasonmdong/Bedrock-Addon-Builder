          "items": {
            "type": "string"
          }
        },
        "behaviorPackManifestCount": {
          "title": "Behavior Pack Manifest Count",
          "type": "integer"
        },
        "unknownJsonCount": {
          "title": "Unknown JSON Count",
          "type": "integer"
        },
        "entityTypeManifestCount": {
          "title": "Entity Type Manifest Count",
          "type": "integer"
        },
        "itemTypeManifestCount": {
