{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/info_set/info_set.form.json",
  "title": "Info Set",
  "description": "Comprehensive view of the generator output captured by Minecraft Creator Tools.",
  "type": "object",
  "properties": {
    "info": {
      "title": "Info",
      "description": "\n\nProperties:\n• capabilities (string[])\n• behaviorPackManifestCount (int)\n• unknownJsonCount (int)\n• entityTypeManifestCount (int)\n• itemTypeManifestCount (int)\n• blockTypeManifestCount (int)\n• resourcePackManifestCount (int)\n• worldCount (int)\n• ... and 67 more properties\n\nSample values:\n• Test Addon Repoert: {\"capabilities\":[\"behaviorAnimations\",\"behavior...",
      "$ref": "#/$defs/info_set_info",
      "defaultSnippets": [
        {
          "label": "Info Set Details",
          "description": "Provides detailed content metrics and counts.",
          "body": {
            "behaviorPackManifestCount": 0,
            "unknownJsonCount": 0,
            "entityTypeManifestCount": 0,
            "itemTypeManifestCount": 0,
            "blockTypeManifestCount": 0,
            "resourcePackManifestCount": 0,
            "worldCount": 0,
            "entityTypeResourceCount": 0,
            "behaviorPackAnimationCount": 0,
            "behaviorPackAnimationControllerCount": 0,
            "overallSize": 0,
            "fileCounts": 0,
            "folderCounts": 0,
            "contentSize": 0,
            "contentFileCounts": 0,
            "contentFolderCounts": 0,
            "minBehaviorPackMinEngineVersion": 0,
            "minResourcePackMinEngineVersion": 0,
            "subpackCount": 0,
            "mctoolsVersion": 0,
            "completeVanillaCopy": 0,
            "partialVanillaCopy": 0,
            "animationCount": 0,
            "textureCount": 0,
            "textureTexelSize": 0,
            "vanillaGameTextureCoverage": 0,
            "vanillaGameTextureCount": 0,
            "minimumSupportablePerformanceTier": 0,
            "invalidCommandSyntaxCount": 0,
            "linesWithSlashCount": 0,
            "multipleSoundsManifests": 0,
            "soundsDefinitionManifestFormatIsValid": 0,
            "soundsDefinitionManifestIsNotValidJson": 0,
            "flagIsOrWasTrue": 0,
            "levelDatNotFound": 0,
            "worldNotFound": 0,
            "deprecatedBlockOverride": 0,
            "deprecatedTerrainTexture": 0,
            "deprecatedTexture": 0,
            "restrictedPolyMeshFound": 0,
            "jsonParseError": 0,
            "invalidManifestJson": 0,
            "missingResourcePackDependencies": 0,
            "internalProcessingErrors": 0,
            "invalidWorldPackReferencesJson": 0,
            "missingWorldPackReferencesFile": 0,
            "invalidPackIds": 0,
            "missingManifestVersion": 0,
            "invalidManifestVersion": 0,
            "packReferencesNotFound": 0,
            "minBaseGameVersion": 0,
            "chunkCount": 0,
            "subchunkLessChunkCount": 0,
            "worldLoadErrors": 0,
            "errorCount": 0,
            "internalProcessingErrorCount": 0,
            "warningCount": 0,
            "testSuccessCount": 0,
            "testFailCount": 0,
            "testNotApplicableCount": 0,
            "infoGenerationTime": 0,
            "endToEndGenerationTime": 0
          }
        }
      ]
    },
    "items": {
      "title": "Items",
      "description": "\n\nProperties:\n• iTp (int)\n• gId (string)\n• gIx (int)\n• p (string)\n• d (string)\n• m\n• fs\n\nSample values:\n• Test Addon Repoert: [{\"iTp\":0,\"gId\":\"CADDONIREQ\",\"gIx\":0},{\"iTp\":3,...",
      "type": "array",
      "items": {
        "$ref": "#/$defs/info_set_item"
      }
    },
    "index": {
      "title": "Index",
      "description": "\n\nSample values:\n• Test Addon Repoert: {\"items\":[\"/Content/resource_packs/aop_mobsrp/t...",
      "$ref": "#/$defs/info_set_index"
    },
    "generatorName": {
      "title": "Generator Name",
      "description": "\n\nSample values:\n• Test Addon Repoert: Minecraft Creator Tools",
      "type": "string"
    },
    "generatorDisplayName": {
      "title": "Generator Display Name",
      "type": "string"
    },
    "generatorVersion": {
      "title": "Generator Version",
      "description": "\n\nSample values:\n• Test Addon Repoert: 0.0.1",
      "type": "string"
    },
    "generatedDate": {
      "title": "Generated Date",
      "description": "ISO-8601 timestamp describing when this info set was captured.",
      "type": "string"
    },
    "suite": {
      "title": "Suite",
      "description": "Numeric identifier for the validation suite that produced this info set.\n\nSample values:\n• Test Addon Repoert: 2",
      "type": "integer"
    },
    "subsetReports": {
      "title": "Subset Reports",
      "description": "Optional nested reports for focused subsets of the analyzed content.\n\nProperties:\n• id (string)\n• title (string)\n• status (string)\n• details\n• metrics\n• items (string[])\n\nSample values:\n• Test Addon Repoert: []",
      "type": "array",
      "items": {
        "$ref": "#/$defs/info_set_subset_report"
      }
    }
  },
  "required": [
    "info",
    "generatorName",
    "generatorVersion"
  ],
  "$defs": {
    "info_set_feature_set_entry": {
      "type": "object",
      "title": "Feature Set Metric",
      "description": "Describes a single metric collected while processing a content feature set.",
      "properties": {
        "count": {
          "title": "Count",
          "description": "Number of occurrences attributed to this feature.",
          "type": "integer"
        }
      }
    },
    "info_set_summary_entry": {
      "type": "object",
      "title": "Summary Entry",
      "description": "Represents a single validation outcome keyed by requirement code.",
      "properties": {
        "title": {
          "title": "Title",
          "type": "string"
        },
        "defaultMessage": {
          "title": "Default Message",
          "type": "string"
        },
        "errors": {
          "title": "Errors",
          "type": "integer"
        },
        "testCompleteFails": {
          "title": "Test Complete Fails",
          "type": "integer"
        },
        "testCompleteSuccesses": {
          "title": "Test Complete Successes",
          "type": "integer"
        }
      }
    },
    "info_set_summary": {
      "type": "object",
      "title": "Validation Summary",
      "description": "Aggregated results grouped by validator.",
      "properties": {
        "CADDONIREQ": {
          "title": "Cooperative Add-On Item Requirements",
          "description": "Entries keyed by numeric requirement code.\n\nProperties:\n• title (string)\n• defaultMessage\n• errors (int)\n• testCompleteFails (int)\n• testCompleteSuccesses (int)",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/info_set_summary_entry"
          }
        },
        "CADDONREQ": {
          "title": "Cooperative Add-On Requirements",
          "description": "\n\nProperties:\n• title (string)\n• defaultMessage\n• errors (int)\n• testCompleteFails (int)\n• testCompleteSuccesses (int)",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/info_set_summary_entry"
          }
        },
        "MINENGINEVER": {
          "title": "Minimum Engine Version",
          "description": "\n\nProperties:\n• title (string)\n• defaultMessage\n• errors (int)\n• testCompleteFails (int)\n• testCompleteSuccesses (int)",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/info_set_summary_entry"
          }
        },
        "PACKSIZE": {
          "title": "Pack Size",
          "description": "\n\nProperties:\n• title (string)\n• defaultMessage\n• errors (int)\n• testCompleteFails (int)\n• testCompleteSuccesses (int)",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/info_set_summary_entry"
          }
        },
        "STRICT": {
          "title": "Strict Platform Info",
          "description": "\n\nProperties:\n• title (string)\n• defaultMessage\n• errors (int)\n• testCompleteFails (int)\n• testCompleteSuccesses (int)",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/info_set_summary_entry"
          }
        },
        "TEXTURE": {
          "title": "Texture Validation",
          "description": "\n\nProperties:\n• title (string)\n• defaultMessage\n• errors (int)\n• testCompleteFails (int)\n• testCompleteSuccesses (int)",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/info_set_summary_entry"
          }
        },
        "WORLDDATA": {
          "title": "World Data Validation",
          "description": "\n\nProperties:\n• title (string)\n• defaultMessage\n• errors (int)\n• testCompleteFails (int)\n• testCompleteSuccesses (int)",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/info_set_summary_entry"
          }
        }
      }
    },
    "info_set_info": {
      "type": "object",
      "title": "Info Set Details",
      "description": "Provides detailed content metrics and counts.",
