{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/info_set/subset_report.form.json",
  "title": "Subset Report",
  "description": "Optional nested report emitted for a focused subset of content.",
  "type": "object",
  "properties": {
    "id": {
      "title": "Identifier",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "status": {
      "title": "Status",
      "type": "string"
    },
    "details": {
      "title": "Details",
      "type": "string"
    },
    "metrics": {
      "title": "Metrics",
      "description": "\n\nProperties:\n• count (int)",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/info_set_feature_set_entry"
      }
    },
    "items": {
      "title": "Items",
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "info_set_feature_set_entry": {
      "type": "object",
      "title": "Feature Set Metric",
      "description": "Describes a single metric collected while processing a content feature set.",
      "properties": {
        "count": {
          "title": "Count",
          "description": "Number of occurrences attributed to this feature.",
          "type": "integer"
        }
      }
    }
  }
}