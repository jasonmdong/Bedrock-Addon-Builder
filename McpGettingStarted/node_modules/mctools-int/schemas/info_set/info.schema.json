{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/info_set/info.form.json",
  "title": "Info Set Details",
  "description": "Provides detailed content metrics and counts.",
  "type": "object",
  "properties": {
    "capabilities": {
      "title": "Capabilities",
      "description": "Set of generator capabilities that were exercised while producing this report.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "behaviorPackManifestCount": {
      "title": "Behavior Pack Manifest Count",
      "type": "integer"
    },
    "unknownJsonCount": {
      "title": "Unknown JSON Count",
      "type": "integer"
    },
    "entityTypeManifestCount": {
      "title": "Entity Type Manifest Count",
      "type": "integer"
    },
    "itemTypeManifestCount": {
      "title": "Item Type Manifest Count",
      "type": "integer"
    },
    "blockTypeManifestCount": {
      "title": "Block Type Manifest Count",
      "type": "integer"
    },
    "resourcePackManifestCount": {
      "title": "Resource Pack Manifest Count",
      "type": "integer"
    },
    "worldCount": {
      "title": "World Count",
      "type": "integer"
    },
    "entityTypeResourceCount": {
      "title": "Entity Type Resource Count",
      "type": "integer"
    },
    "behaviorPackAnimationCount": {
      "title": "Behavior Pack Animation Count",
      "type": "integer"
    },
    "behaviorPackAnimationControllerCount": {
      "title": "Behavior Pack Animation Controller Count",
      "type": "integer"
    },
    "overallSize": {
      "title": "Overall Size (bytes)",
      "type": "integer"
    },
    "fileCounts": {
      "title": "File Count",
      "type": "integer"
    },
    "folderCounts": {
      "title": "Folder Count",
      "type": "integer"
    },
    "contentSize": {
      "title": "Content Size",
      "type": "integer"
    },
    "contentFileCounts": {
      "title": "Content File Count",
      "type": "integer"
    },
    "contentFolderCounts": {
      "title": "Content Folder Count",
      "type": "integer"
    },
    "minBehaviorPackMinEngineVersion": {
      "title": "Minimum Behavior Pack Engine Version",
      "type": "integer"
    },
    "minResourcePackMinEngineVersion": {
      "title": "Minimum Resource Pack Engine Version",
      "type": "integer"
    },
    "subpackCount": {
      "title": "Sub-pack Count",
      "type": "integer"
    },
    "entityTypeComponents": {
      "title": "Entity Type Components",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blockTypeComponents": {
      "title": "Block Type Components",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "itemTypeComponents": {
      "title": "Item Type Components",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "apisUsed": {
      "title": "APIs Used",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mctoolsVersion": {
      "title": "Minecraft Creator Tools Version",
      "type": "integer"
    },
    "itemTypes": {
      "title": "Item Types",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "completeVanillaCopy": {
      "title": "Complete Vanilla Copy",
      "type": "integer"
    },
    "partialVanillaCopy": {
      "title": "Partial Vanilla Copy",
      "type": "integer"
    },
    "animationCount": {
      "title": "Animation Count",
      "type": "integer"
    },
    "textureCount": {
      "title": "Texture Count",
      "type": "integer"
    },
    "textureTexelSize": {
      "title": "Texture Texel Size",
      "type": "integer"
    },
    "vanillaGameTextureCoverage": {
      "title": "Vanilla Game Texture Coverage",
      "type": "integer"
    },
    "vanillaGameTextureCount": {
      "title": "Vanilla Game Texture Count",
      "type": "integer"
    },
    "minimumSupportablePerformanceTier": {
      "title": "Minimum Supportable Performance Tier",
      "type": "integer"
    },
    "invalidCommandSyntaxCount": {
      "title": "Invalid Command Syntax Count",
      "type": "integer"
    },
    "linesWithSlashCount": {
      "title": "Lines With Slash Count",
      "type": "integer"
    },
    "multipleSoundsManifests": {
      "title": "Multiple Sounds Manifests",
      "type": "integer"
    },
    "soundsDefinitionManifestFormatIsValid": {
      "title": "Sounds Definition Manifest Format Is Valid",
      "type": "integer"
    },
    "soundsDefinitionManifestIsNotValidJson": {
      "title": "Sounds Definition Manifest Is Not Valid JSON",
      "type": "integer"
    },
    "flagIsOrWasTrue": {
      "title": "Flag Is Or Was True",
      "type": "integer"
    },
    "levelDatNotFound": {
      "title": "level.dat Not Found",
      "type": "integer"
    },
    "worldNotFound": {
      "title": "World Not Found",
      "type": "integer"
    },
    "deprecatedBlockOverride": {
      "title": "Deprecated Block Override",
      "type": "integer"
    },
    "deprecatedTerrainTexture": {
      "title": "Deprecated Terrain Texture",
      "type": "integer"
    },
    "deprecatedTexture": {
      "title": "Deprecated Texture",
      "type": "integer"
    },
    "restrictedPolyMeshFound": {
      "title": "Restricted Poly Mesh Found",
      "type": "integer"
    },
    "jsonParseError": {
      "title": "JSON Parse Error",
      "type": "integer"
    },
    "invalidManifestJson": {
      "title": "Invalid Manifest JSON",
      "type": "integer"
    },
    "missingResourcePackDependencies": {
      "title": "Missing Resource Pack Dependencies",
      "type": "integer"
    },
    "internalProcessingErrors": {
      "title": "Internal Processing Errors",
      "type": "integer"
    },
    "invalidWorldPackReferencesJson": {
      "title": "Invalid World Pack References JSON",
      "type": "integer"
    },
    "missingWorldPackReferencesFile": {
      "title": "Missing World Pack References File",
      "type": "integer"
    },
    "invalidPackIds": {
      "title": "Invalid Pack IDs",
      "type": "integer"
    },
    "missingManifestVersion": {
      "title": "Missing Manifest Version",
      "type": "integer"
    },
    "invalidManifestVersion": {
      "title": "Invalid Manifest Version",
      "type": "integer"
    },
    "packReferencesNotFound": {
      "title": "Pack References Not Found",
      "type": "integer"
    },
    "minBaseGameVersion": {
      "title": "Minimum Base Game Version",
      "type": "integer"
    },
    "chunkCount": {
      "title": "Chunk Count",
      "type": "integer"
    },
    "subchunkLessChunkCount": {
      "title": "Subchunk-less Chunk Count",
      "type": "integer"
    },
    "worldLoadErrors": {
      "title": "World Load Errors",
      "type": "integer"
    },
    "commands": {
      "title": "Commands",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "featureSets": {
      "title": "Feature Sets",
      "description": "Keyed collection of feature metrics produced while scanning content.\n\nProperties:\n• count (int)",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/info_set_feature_set_entry"
      }
    },
    "errorCount": {
      "title": "Error Count",
      "type": "integer"
    },
    "internalProcessingErrorCount": {
      "title": "Internal Processing Error Count",
      "type": "integer"
    },
    "warningCount": {
      "title": "Warning Count",
      "type": "integer"
    },
    "testSuccessCount": {
      "title": "Test Success Count",
      "type": "integer"
    },
    "testFailCount": {
      "title": "Test Failure Count",
      "type": "integer"
    },
    "testNotApplicableCount": {
      "title": "Test Not Applicable Count",
      "type": "integer"
    },
    "errorSummary": {
      "title": "Error Summary",
      "type": "string"
    },
    "internalProcessingErrorSummary": {
      "title": "Internal Processing Error Summary",
      "type": "string"
    },
    "warningSummary": {
      "title": "Warning Summary",
      "type": "string"
    },
    "testFailSummary": {
      "title": "Test Failure Summary",
      "type": "string"
    },
    "infoGenerationTime": {
      "title": "Info Generation Time (ms)",
      "type": "integer"
    },
    "endToEndGenerationTime": {
      "title": "End-to-End Generation Time (ms)",
      "type": "integer"
    },
    "summary": {
      "title": "Summary",
      "description": "\n\nProperties:\n• CADDONIREQ\n• CADDONREQ\n• MINENGINEVER\n• PACKSIZE\n• STRICT\n• TEXTURE\n• WORLDDATA",
      "$ref": "#/$defs/info_set_summary"
    }
  },
  "$defs": {
    "info_set_feature_set_entry": {
      "type": "object",
      "title": "Feature Set Metric",
      "description": "Describes a single metric collected while processing a content feature set.",
      "properties": {
        "count": {
          "title": "Count",
          "description": "Number of occurrences attributed to this feature.",
          "type": "integer"
        }
      }
    },
    "info_set_summary_entry": {
      "type": "object",
      "title": "Summary Entry",
      "description": "Represents a single validation outcome keyed by requirement code.",
      "properties": {
        "title": {
          "title": "Title",
          "type": "string"
        },
        "defaultMessage": {
          "title": "Default Message",
          "type": "string"
        },
        "errors": {
          "title": "Errors",
          "type": "integer"
        },
        "testCompleteFails": {
          "title": "Test Complete Fails",
          "type": "integer"
        },
        "testCompleteSuccesses": {
          "title": "Test Complete Successes",
          "type": "integer"
        }
      }
    },
    "info_set_summary": {
      "type": "object",
      "title": "Validation Summary",
      "description": "Aggregated results grouped by validator.",
      "properties": {
        "CADDONIREQ": {
          "title": "Cooperative Add-On Item Requirements",
          "description": "Entries keyed by numeric requirement code.\n\nProperties:\n• title (string)\n• defaultMessage\n• errors (int)\n• testCompleteFails (int)\n• testCompleteSuccesses (int)",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/info_set_summary_entry"
          }
        },
        "CADDONREQ": {
          "title": "Cooperative Add-On Requirements",
          "description": "\n\nProperties:\n• title (string)\n• defaultMessage\n• errors (int)\n• testCompleteFails (int)\n• testCompleteSuccesses (int)",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/info_set_summary_entry"
          }
        },
        "MINENGINEVER": {
          "title": "Minimum Engine Version",
          "description": "\n\nProperties:\n• title (string)\n• defaultMessage\n• errors (int)\n• testCompleteFails (int)\n• testCompleteSuccesses (int)",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/info_set_summary_entry"
          }
        },
        "PACKSIZE": {
          "title": "Pack Size",
          "description": "\n\nProperties:\n• title (string)\n• defaultMessage\n• errors (int)\n• testCompleteFails (int)\n• testCompleteSuccesses (int)",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/info_set_summary_entry"
          }
        },
        "STRICT": {
          "title": "Strict Platform Info",
          "description": "\n\nProperties:\n• title (string)\n• defaultMessage\n• errors (int)\n• testCompleteFails (int)\n• testCompleteSuccesses (int)",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/info_set_summary_entry"
          }
        },
        "TEXTURE": {
          "title": "Texture Validation",
          "description": "\n\nProperties:\n• title (string)\n• defaultMessage\n• errors (int)\n• testCompleteFails (int)\n• testCompleteSuccesses (int)",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/info_set_summary_entry"
          }
        },
        "WORLDDATA": {
          "title": "World Data Validation",
          "description": "\n\nProperties:\n• title (string)\n• defaultMessage\n• errors (int)\n• testCompleteFails (int)\n• testCompleteSuccesses (int)",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/info_set_summary_entry"
          }
        }
      }
    }
  }
}