{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/action_set/action.form.json",
  "title": "Action",
  "description": "Represents a single action that can be executed as part of an action set. Actions include spawning entities, breaking blocks, playing sounds, and other world modifications. Each action has a type that determines its behavior and required arguments.",
  "type": "object",
  "properties": {
    "id": {
      "title": "Action Identifier",
      "type": "string"
    },
    "type": {
      "title": "Type",
      "type": "string",
      "enum": [
        "block_break",
        "block_explode",
        "block_set",
        "entity_die",
        "entity_spawn",
        "item_spawn",
        "music_play",
        "particle_spawn",
        "player_join",
        "sound_play",
        "test_idle",
        "test_simulated_player_move",
        "test_simulated_player_spawn",
        "tick",
        "world_send_message"
      ]
    },
    "args": {
      "title": "Arguments",
      "type": "object"
    },
    "value": {
      "title": "Value",
      "type": "string"
    },
    "withId": {
      "title": "With Id",
      "type": "string"
    },
    "setId": {
      "title": "Set Id",
      "type": "string"
    }
  }
}