{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/item_components/minecraft_entity_placer.form.json",
  "title": "Item Components Entity Placer",
  "description": "Allows an item to place entities into the world. Additionally, in version 1.19.80 and above, the component allows the item to set the spawn type of a monster spawner.",
  "type": "object",
  "properties": {
    "dispense_on": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "title": "Name",
                "type": "string",
                "default": ""
              },
              "states": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "string"
                  },
                  {
                    "type": "boolean"
                  }
                ],
                "title": "States"
              },
              "tags": {
                "title": "Tags",
                "type": "string",
                "default": ""
              }
            }
          }
        },
        {
          "type": "string"
        },
        {
          "type": "object"
        }
      ],
      "title": "dispense_on",
      "description": "List of block descriptors of the blocks that this item can be dispensed on. If left empty, all blocks will be allowed.\n\nProperties:\n• name (string) = \n• states (int) = {}\n• tags (string) = "
    },
    "entity": {
      "title": "Entity",
      "description": "The entity to be placed in the world.\n\nSample values:\n• my_sword_turtle: minecraft:turtle",
      "type": "object",
      "pattern": "^(?:\\w+(?:\\.\\w+)*:(?=\\w))?(?:\\w+(?:\\.\\w+)*)(?:<((?:\\w+(?:\\.\\w+)*:(?=\\w))?\\w+(?:\\.\\w+)*)*>)?$",
      "default": ""
    },
    "use_on": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "title": "Name",
                "type": "string",
                "default": ""
              },
              "states": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "string"
                  },
                  {
                    "type": "boolean"
                  }
                ],
                "title": "States"
              },
              "tags": {
                "title": "Tags",
                "type": "string",
                "default": ""
              }
            }
          }
        },
        {
          "type": "string"
        },
        {
          "type": "object"
        }
      ],
      "title": "use_on",
      "description": "List of block descriptors of the blocks that this item can be used on. If left empty, all blocks will be allowed.\n\nProperties:\n• name (string) = \n• states (int) = {}\n• tags (string) = \n\nSample values:\n• my_sword_turtle: [\"minecraft:sand\"]"
    }
  }
}