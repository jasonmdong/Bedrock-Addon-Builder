{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/item_components/minecraft_dyeable.form.json",
  "title": "Item Components Dyeable",
  "description": "enables custom items to be dyed in cauldrons. To use the dyeable component, the format version on the item and the attachable needs to have a format_version of 1.21.30 or greater.",
  "type": "object",
  "properties": {
    "default_color": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minLength": 3,
          "maxLength": 3
        }
      ],
      "title": "Default Color",
      "description": "default_color",
      "defaultSnippets": [
        {
          "label": "Default Color (default)",
          "description": "Use default value: 255,255,255",
          "body": [
            255,
            255,
            255
          ]
        }
      ]
    }
  }
}