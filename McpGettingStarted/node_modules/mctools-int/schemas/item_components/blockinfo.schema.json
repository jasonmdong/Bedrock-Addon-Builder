{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/item_components/blockinfo.form.json",
  "title": "Item Components BlockInfo",
  "description": "Has block and digging speed configuration.",
  "type": "object",
  "properties": {
    "block": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "name": {
              "title": "Name",
              "type": "string",
              "default": ""
            },
            "states": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "string"
                },
                {
                  "type": "boolean"
                }
              ],
              "title": "States"
            },
            "tags": {
              "title": "Tags",
              "type": "string",
              "default": ""
            }
          }
        },
        {
          "type": "string"
        },
        {
          "type": "object"
        }
      ],
      "description": "Block to be dug.\n\nProperties:\n• name (string) = \n• states (int) = {}\n• tags (string) = "
    },
    "speed": {
      "title": "Speed",
      "description": "Digging speed for the correlating block(s).",
      "type": "integer"
    }
  },
  "required": [
    "block",
    "speed"
  ]
}