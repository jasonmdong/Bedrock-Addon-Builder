{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/client_block/rule_geometry_part.form.json",
  "title": "Client Block Rule Geometry Part",
  "description": "Specifies a geometry part for culling.",
  "type": "object",
  "properties": {
    "bone": {
      "title": "Bone",
      "type": "string"
    },
    "cube": {
      "title": "Cube",
      "type": "integer"
    },
    "face": {
      "title": "Facing",
      "type": "string",
      "enum": [
        "down",
        "east",
        "north",
        "south",
        "up",
        "west"
      ]
    }
  },
  "required": [
    "bone"
  ]
}