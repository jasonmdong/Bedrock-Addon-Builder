                "grid_offset": 0,
                "step_size": 0
              }
            }
          ]
        }
      ],
      "title": "Z",
      "description": "Distribution for the coordinate (evaluated each iteration).",
      "defaultSnippets": [
        {
          "label": "Z (object)",
          "description": "Use Z as an object",
          "body": {
            "distribution": "",
            "extent": "",
            "grid_offset": 0,
            "step_size": 0
          }
        }
      ]
    }
  },
  "required": [
    "iterations",
    "x",
    "y",
    "z"
  ]
