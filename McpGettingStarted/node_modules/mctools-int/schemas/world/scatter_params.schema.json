{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/world/scatter_params.form.json",
  "title": "World Scatter Params",
  "description": "Controls the scatter distribution of a particular object.",
  "type": "object",
  "properties": {
    "coordinate_eval_order": {
      "title": "Coordinate Evaluation Order",
      "description": "The order in which coordinates will be evaluated. Should be used when a coordinate depends on another. If omitted, defaults to \"xzy\". Supported orders are defined by \"Coordinate Evaluation Order\".",
      "type": "string",
      "enum": [
        "xyz",
        "xzy",
        "yxz",
        "yzx",
        "zxy",
        "zyx"
      ],
      "default": "xzy"
    },
    "iterations": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        {
          "type": "string"
        },
        {
          "description": "\n\nProperties:\n• expression (string)\n• version (int)",
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "expression": {
                "title": "Expression",
                "type": "string"
              },
              "version": {
                "title": "Version",
                "type": "integer"
              }
            }
          }
        },
        {
          "type": "number"
        }
      ],
      "title": "Iterations",
      "description": "Number of scattered positions to generate."
    },
    "scatter_chance": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "description": "\n\nProperties:\n• denominator (int)\n• numerator (int)",
          "type": "object",
          "properties": {
            "denominator": {
              "title": "Denominator",
              "description": "Denominator for scatter probability.",
              "type": "integer",
              "minimum": 1
            },
            "numerator": {
              "title": "Numerator",
              "description": "Numerator for scatter probability.",
              "type": "integer",
              "minimum": 1
            }
          },
          "defaultSnippets": [
            {
              "label": "Scatter Chance (object)",
              "description": "Use Scatter Chance as an object",
              "body": {
                "denominator": 0,
                "numerator": 0
              }
            }
          ]
        }
      ],
      "title": "Scatter Chance",
      "description": "Probability that this scatter will occur. Not evaluated each iteration; either no iterations will run, or all will.",
      "defaultSnippets": [
        {
          "label": "Scatter Chance (object)",
          "description": "Use Scatter Chance as an object",
          "body": {
            "denominator": 0,
            "numerator": 0
          }
        }
      ]
    },
    "x": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "description": "\n\nProperties:\n• distribution (string)\n• extent (object) [maxLen: 2]\n• grid_offset (int)\n• step_size (int)",
          "type": "object",
          "properties": {
            "distribution": {
              "title": "Random Distribution Type",
              "description": "Type of distribution. Supported distributions are defined by \"Random Distribution Type\".",
              "type": "string",
              "enum": [
                "fixed_grid",
                "gaussian",
                "inverse_gaussian",
                "jittered_grid",
                "triangle",
                "uniform"
              ]
            },
            "extent": {
              "title": "Extent",
              "description": "Lower and upper bound (inclusive) of the scatter range, as an offset from the input point to scatter around.",
              "type": "object",
              "minLength": 2,
              "maxLength": 2
            },
            "grid_offset": {
              "title": "Grid Offset",
              "description": "When the distribution type is grid, defines the offset along this axis.",
              "type": "integer"
            },
            "step_size": {
              "title": "Step Size",
              "description": "When the distribution type is grid, defines the distance between steps along this axis.",
              "type": "integer",
              "minimum": 1
            }
          },
          "defaultSnippets": [
            {
              "label": "X (object)",
              "description": "Use X as an object",
              "body": {
                "distribution": "",
                "extent": "",
                "grid_offset": 0,
                "step_size": 0
              }
            }
          ]
        }
      ],
      "title": "X",
      "description": "Distribution for the coordinate (evaluated each iteration).",
      "defaultSnippets": [
        {
          "label": "X (object)",
          "description": "Use X as an object",
          "body": {
            "distribution": "",
            "extent": "",
            "grid_offset": 0,
            "step_size": 0
          }
        }
      ]
    },
