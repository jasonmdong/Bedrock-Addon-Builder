{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/world/constantintprovider.form.json",
  "title": "World ConstantIntProvider",
  "description": "Specifies a constant integer",
  "type": "object",
  "properties": {
    "type": {
      "title": "IntProviderType",
      "type": "string",
      "enum": [
        "constant",
        "uniform"
      ]
    },
    "value": {
      "title": "Value",
      "description": "Constant value",
      "type": "integer"
    }
  },
  "required": [
    "type",
    "value"
  ]
}