{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/world/randomblockstatematch.form.json",
  "title": "World RandomBlockStateMatch",
  "description": "Predicate that evaluates to true with a given probability if the block at the specified location matches the specified block.",
  "type": "object",
  "properties": {
    "block_state": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "description": "\n\nProperties:\n• name (object)\n• states = {}",
          "type": "object",
          "properties": {
            "name": {
              "title": "Name",
              "description": "Name of the block",
              "type": "object"
            },
            "states": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": {
                    "type": "number"
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": {
                    "type": "boolean"
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              ],
              "title": "States",
              "description": "Contains members named after each state, with boolean, integer, or string values."
            }
          },
          "defaultSnippets": [
            {
              "label": "Block State (object)",
              "description": "Use Block State as an object",
              "body": {
                "name": "",
                "states": {}
              }
            }
          ]
        }
      ],
      "description": "The block state to match against.",
      "defaultSnippets": [
        {
          "label": "Block State (object)",
          "description": "Use Block State as an object",
          "body": {
            "name": "",
            "states": {}
          }
        }
      ]
    },
    "predicate_type": {
      "title": "BlockType",
      "type": "string",
      "enum": [
        "minecraft:always_true",
        "minecraft:block_match",
        "minecraft:blockstate_match",
        "minecraft:random_block_match",
        "minecraft:random_blockstate_match",
        "minecraft:tag_match"
      ]
    },
    "probability": {
      "title": "Probability",
      "description": "Probability of the evaluating to true when the block matches.",
      "type": "number",
      "maximum": 1
    }
  },
  "required": [
    "block_state",
    "predicate_type",
    "probability"
  ]
}