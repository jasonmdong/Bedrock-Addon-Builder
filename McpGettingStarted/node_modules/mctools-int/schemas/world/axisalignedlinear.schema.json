{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/world/axisalignedlinear.form.json",
  "title": "World AxisAlignedLinear",
  "description": "Predicate that evaluates to true if the block is within the distance range along the provided axis and a random number is generated between the chance range.",
  "type": "object",
  "properties": {
    "axis": {
      "title": "PositionalBlockRuleAxis",
      "type": "string",
      "enum": [
        "x",
        "y",
        "z"
      ],
      "default": "y"
    },
    "max_chance": {
      "title": "Max Chance",
      "type": "number",
      "exclusiveMaximum": 1,
      "default": 0
    },
    "max_dist": {
      "title": "Max Dist",
      "type": "integer",
      "default": 0
    },
    "min_chance": {
      "title": "Min Chance",
      "type": "number",
      "exclusiveMaximum": 1,
      "default": 0
    },
    "min_dist": {
      "title": "Min Dist",
      "type": "integer",
      "default": 0
    },
    "predicate_type": {
      "title": "PosType",
      "type": "string",
      "enum": [
        "minecraft:always_true",
        "minecraft:axis_aligned_linear_pos"
      ]
    }
  },
  "required": [
    "predicate_type"
  ]
}