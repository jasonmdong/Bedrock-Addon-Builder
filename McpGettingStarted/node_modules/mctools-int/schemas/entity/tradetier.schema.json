      "defaultSnippets": [
        {
          "label": "Entity TradeGroup",
          "description": "Groups related trade offers that may be randomly selected from within a tier. When an entity unlocks a tier, trades are chosen from groups within that tier. Configure how many trades to select from the group. Enables variety in merchant inventories so not every villager of the same profession offers identical goods.",
          "body": {
            "num_to_select": 0,
            "trades": ""
          }
        }
      ]
    },
    "total_exp_required": {
      "title": "Total Exp Required",
      "type": "integer"
    }
  },
