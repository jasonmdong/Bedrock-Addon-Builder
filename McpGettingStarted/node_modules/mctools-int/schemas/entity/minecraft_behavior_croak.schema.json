{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/entity/minecraft_behavior_croak.form.json",
  "title": "Croak Behavior",
  "description": "Allows the entity to croak at a random time interval with configurable conditions.",
  "type": "object",
  "properties": {
    "duration": {
      "title": "Duration",
      "description": "Random range in seconds after which the croaking stops. Can also be a constant.\n\nSample values:\n• frog: 4.5",
      "oneOf": [
        {
          "type": "integer"
        },
        {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 2,
          "maxItems": 2
        },
        {
          "type": "object",
          "properties": {
            "min": {
              "type": "integer",
              "description": "Minimum value of the range"
            },
            "max": {
              "type": "integer",
              "description": "Maximum value of the range"
            }
          }
        }
      ]
    },
    "filters": {
      "title": "Filters",
      "description": "Conditions for the behavior to start and keep running. The interval between runs only starts after passing the filters.\n\nSample values:\n• frog: {\"all_of\":[{\"test\":\"in_water\",\"value\":false},{\"...",
      "anyOf": [
        {
          "type": "object"
        },
        {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        {
          "type": "object",
          "properties": {
            "all_of": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "any_of": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "none_of": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        }
      ]
    },
    "interval": {
      "title": "Interval",
      "description": "Random range in seconds between runs of this behavior. Can also be a constant.\n\nSample values:\n• frog: [10,20]",
      "oneOf": [
        {
          "type": "integer"
        },
        {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 2,
          "maxItems": 2
        },
        {
          "type": "object",
          "properties": {
            "min": {
              "type": "integer",
              "description": "Minimum value of the range"
            },
            "max": {
              "type": "integer",
              "description": "Maximum value of the range"
            }
          }
        }
      ]
    },
    "priority": {
      "title": "Priority",
      "description": "As priority approaches 0, the priority is increased. The higher the priority, the sooner this behavior will be executed as a goal.",
      "type": "integer"
    }
  }
}