{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/entity/tradeitem.form.json",
  "title": "Entity TradeItem",
  "description": "Specifies an item stack used in trading—either as input (what players pay) or output (what players receive). Configure the item type, quantity range, enchantment probability, and function modifiers. Supports emeralds, resources, tools, armor, enchanted books, and any registered item as tradeable goods.",
  "type": "object",
  "properties": {
    "filters": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "domain": {
              "title": "Domain",
              "description": "The domain the test should be performed in.",
              "type": "object"
            },
            "operator": {
              "title": "Operator",
              "description": "The comparison to apply with 'value'.",
              "type": "object"
            },
            "subject": {
              "title": "Subject",
              "description": "The subject of this filter test.",
              "type": "object"
            },
            "test": {
              "title": "Test",
              "description": "The name of the test to apply.",
              "type": "string"
            },
            "value": {
              "title": "Value",
              "description": "The value being compared with the test.",
              "type": "object"
            }
          }
        },
        {
          "type": "object"
        }
      ],
      "description": "Filters allow data objects to specify test criteria which allows their use. Filters can be defined by a single object of type (Filter Test), an array of tests, collection groups, or a combination of these objects.\n\nProperties:\n• domain (object)\n• operator (object)\n• subject (object)\n• test (string)\n• value (object)"
    },
    "functions": {
      "title": "Functions",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "item": {
      "title": "Item",
      "type": "object"
    },
    "price_multiplier": {
      "title": "Price Multiplier",
      "type": "number",
      "default": 0
    },
    "quantity": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "description": "\n\nProperties:\n• max (int) = 1\n• min (int) = 1",
          "type": "object",
          "properties": {
            "max": {
              "title": "Max",
              "type": "integer",
              "minimum": 1,
              "default": 1
            },
            "min": {
              "title": "Min",
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          "defaultSnippets": [
            {
              "label": "Quantity (object)",
              "description": "Use Quantity as an object",
              "body": {
                "max": 1,
                "min": 1
              }
            }
          ]
        }
      ],
      "title": "Quantity",
      "defaultSnippets": [
        {
          "label": "Quantity (object)",
          "description": "Use Quantity as an object",
          "body": {
            "max": 1,
            "min": 1
          }
        }
      ]
    }
  },
  "required": [
    "item"
  ]
}