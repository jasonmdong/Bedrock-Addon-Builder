{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/entity/basemovetodefinition.form.json",
  "title": "Entity BaseMoveToDefinition",
  "type": "object",
  "properties": {
    "control_flags": {
      "title": "Control Flags",
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "jump",
          "look",
          "move"
        ]
      }
    },
    "priority": {
      "title": "Priority",
      "type": "integer",
      "default": 0
    },
    "speed_multiplier": {
      "title": "Speed Multiplier",
      "description": "Movement speed multiplier of the mob when using this goal.",
      "type": "number",
      "default": 1
    }
  }
}