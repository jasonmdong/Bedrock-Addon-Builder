{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/client_misc/shape.form.json",
  "title": "Shape Misc",
  "description": "Defines a shape composed of boxes.",
  "type": "object",
  "properties": {
    "boxes": {
      "title": "Boxes",
      "description": "\n\nProperties:\n• max\n• min",
      "$ref": "#/$defs/misc_box",
      "defaultSnippets": [
        {
          "label": "Box Misc",
          "description": "Defines box configuration.",
          "body": {
            "max": "",
            "min": ""
          }
        }
      ],
      "minLength": 1
    }
  },
  "required": [
    "boxes"
  ],
  "$defs": {
    "misc_box": {
      "type": "object",
      "title": "Box Misc",
      "description": "Defines box configuration.",
      "properties": {
        "max": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            {
              "description": "\n\nProperties:\n• x (float)\n• y (float)\n• z (float)",
              "type": "object",
              "properties": {
                "x": {
                  "title": "X",
                  "type": "number"
                },
                "y": {
                  "title": "Y",
                  "type": "number"
                },
                "z": {
                  "title": "Z",
                  "type": "number"
                }
              },
              "defaultSnippets": [
                {
                  "label": "Max (object)",
                  "description": "Use Max as an object",
                  "body": {
                    "x": 0,
                    "y": 0,
                    "z": 0
                  }
                }
              ]
            }
          ],
          "title": "Max",
          "defaultSnippets": [
            {
              "label": "Max (object)",
              "description": "Use Max as an object",
              "body": {
                "x": 0,
                "y": 0,
                "z": 0
              }
            }
          ]
        },
        "min": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            {
              "description": "\n\nProperties:\n• x (float)\n• y (float)\n• z (float)",
              "type": "object",
              "properties": {
                "x": {
                  "title": "X",
                  "type": "number"
                },
                "y": {
                  "title": "Y",
                  "type": "number"
                },
                "z": {
                  "title": "Z",
                  "type": "number"
                }
              },
              "defaultSnippets": [
                {
                  "label": "Min (object)",
                  "description": "Use Min as an object",
                  "body": {
                    "x": 0,
                    "y": 0,
                    "z": 0
                  }
                }
              ]
            }
          ],
          "title": "Min",
          "defaultSnippets": [
            {
              "label": "Min (object)",
              "description": "Use Min as an object",
              "body": {
                "x": 0,
                "y": 0,
                "z": 0
              }
            }
          ]
        }
      },
      "required": [
        "max",
        "min"
      ]
    }
  }
}