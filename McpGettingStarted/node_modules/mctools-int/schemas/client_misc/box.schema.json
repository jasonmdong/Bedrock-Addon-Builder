{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/client_misc/box.form.json",
  "title": "Box Misc",
  "description": "Defines a 3D bounding box with min and max coordinates.",
  "type": "object",
  "properties": {
    "max": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        {
          "description": "\n\nProperties:\n• x (float)\n• y (float)\n• z (float)",
          "type": "object",
          "properties": {
            "x": {
              "title": "X",
              "type": "number"
            },
            "y": {
              "title": "Y",
              "type": "number"
            },
            "z": {
              "title": "Z",
              "type": "number"
            }
          },
          "defaultSnippets": [
            {
              "label": "Max (object)",
              "description": "Use Max as an object",
              "body": {
                "x": 0,
                "y": 0,
                "z": 0
              }
            }
          ]
        }
      ],
      "title": "Max",
      "defaultSnippets": [
        {
          "label": "Max (object)",
          "description": "Use Max as an object",
          "body": {
            "x": 0,
            "y": 0,
            "z": 0
          }
        }
      ]
    },
    "min": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        {
          "description": "\n\nProperties:\n• x (float)\n• y (float)\n• z (float)",
          "type": "object",
          "properties": {
            "x": {
              "title": "X",
              "type": "number"
            },
            "y": {
              "title": "Y",
              "type": "number"
            },
            "z": {
              "title": "Z",
              "type": "number"
            }
          },
          "defaultSnippets": [
            {
              "label": "Min (object)",
              "description": "Use Min as an object",
              "body": {
                "x": 0,
                "y": 0,
                "z": 0
              }
            }
          ]
        }
      ],
      "title": "Min",
      "defaultSnippets": [
        {
          "label": "Min (object)",
          "description": "Use Min as an object",
          "body": {
            "x": 0,
            "y": 0,
            "z": 0
          }
        }
      ]
    }
  },
  "required": [
    "max",
    "min"
  ]
}