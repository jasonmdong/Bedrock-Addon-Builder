{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/client_misc/color_proxy.form.json",
  "title": "Color Proxy Client Misc",
  "description": "Defines a color gradient with interpolation.",
  "type": "object",
  "properties": {
    "gradient": {
      "title": "Gradient",
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "interpolant": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        {
          "type": "string"
        },
        {
          "description": "\n\nProperties:\n• expression (string)\n• version (int)",
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "expression": {
                "title": "Expression",
                "type": "string"
              },
              "version": {
                "title": "Version",
                "type": "integer"
              }
            }
          }
        },
        {
          "type": "number"
        }
      ],
      "title": "Interpolant"
    }
  },
  "required": [
    "gradient",
    "interpolant"
  ]
}