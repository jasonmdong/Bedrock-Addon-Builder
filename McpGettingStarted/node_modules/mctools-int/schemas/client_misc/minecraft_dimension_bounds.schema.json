{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/client_misc/minecraft_dimension_bounds.form.json",
  "title": "Bounds",
  "description": "Defines the min and max height bounds for a dimension.",
  "type": "object",
  "properties": {
    "max": {
      "title": "Max",
      "type": "integer",
      "minimum": -512,
