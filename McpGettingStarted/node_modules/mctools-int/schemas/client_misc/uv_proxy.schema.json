{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/client_misc/uv_proxy.form.json",
  "title": "UV Proxy Client Misc",
  "description": "Controls UV texture mapping and flipbook animation.",
  "type": "object",
  "properties": {
    "flipbook": {
      "title": "Flipbook",
      "type": "object"
    },
    "texture_height": {
      "title": "Texture Height",
      "type": "integer"
    },
    "texture_width": {
      "title": "Texture Width",
      "type": "integer"
    },
    "uv": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        {
          "type": "string"
        },
        {
          "description": "\n\nProperties:\n• expression (string)\n• version (int)",
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "expression": {
                "title": "Expression",
                "type": "string"
              },
              "version": {
                "title": "Version",
                "type": "integer"
              }
            }
          }
        },
        {
          "type": "number"
        }
      ],
      "title": "Uv"
    },
    "uv_size": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        {
          "type": "string"
        },
        {
          "description": "\n\nProperties:\n• expression (string)\n• version (int)",
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "expression": {
                "title": "Expression",
                "type": "string"
              },
              "version": {
                "title": "Version",
                "type": "integer"
              }
            }
          }
        },
        {
          "type": "number"
        }
      ],
      "title": "Uv Size"
    }
  }
}