{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/legacy/commands.form.json",
  "title": "Legacy Commands",
  "description": "Defines legacy command permission levels.",
  "type": "object",
  "properties": {
    "default_permission_level": {
      "title": "Command Permission Level",
      "description": "Default permission level for all unspecified commands.  If not set then commands will default to their normal permission level.",
      "type": "string",
      "enum": [
        "admin",
        "any",
        "game_directors",
        "host",
        "internal",
        "owner"
      ]
    },
    "permission_levels": {
      "title": "Permission Levels",
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}