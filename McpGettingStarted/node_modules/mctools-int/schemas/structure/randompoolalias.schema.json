{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/structure/randompoolalias.form.json",
  "title": "Structure RandomPoolAlias",
  "description": "Pool alias for a Random list of targets",
  "type": "object",
  "properties": {
    "alias": {
      "title": "Alias",
      "description": "Alias of Random Pool",
      "type": "string"
    },
    "targets": {
      "title": "Targets",
      "description": "List of potential pools\n\nProperties:\n• data (object)\n• weight (int)",
      "$ref": "#/$defs/world_jigsawtemplatepool",
      "defaultSnippets": [
        {
          "label": "World JigsawTemplatePool",
          "description": "Weighted Random Item",
          "body": {
            "data": "",
            "weight": 0
          }
        }
      ]
    }
  },
  "required": [
    "alias",
    "targets"
  ],
  "$defs": {
    "world_jigsawtemplatepool": {
      "type": "object",
      "title": "World JigsawTemplatePool",
      "description": "Weighted Random Item",
      "properties": {
        "data": {
          "title": "Data",
          "description": "Item's data",
          "type": "object"
        },
        "weight": {
          "title": "Weight",
          "description": "Weight of item",
          "type": "integer"
        }
      },
      "required": [
        "data",
        "weight"
      ]
    }
  }
}