{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/entityevents/emit_vibration.form.json",
  "title": "Emit Vibration",
  "description": "Allows the entity to emit a vibration having the entity itself as its source.",
  "type": "object",
  "properties": {
    "vibration": {
      "description": "Type of vibration to emit.",
      "type": "string",
      "enum": [
        "entity_interact",
        "entity_act",
        "entity_die"
      ]
    }
  }
}