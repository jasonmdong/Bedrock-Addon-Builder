{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/misc/voxelshapefile.form.json",
  "title": "VoxelShapeFile Misc",
  "description": "Defines voxelshapefile configuration.",
  "type": "object",
  "properties": {
    "description": {
      "title": "Description",
      "description": "\n\nProperties:\n• identifier (object)\n• menu_category (object)",
      "$ref": "#/$defs/misc_description",
      "defaultSnippets": [
        {
          "label": "Description Misc",
          "description": "Contains the required identifier for the item. May contain optional fields like menu_category.",
          "body": {
            "identifier": ""
          }
        }
      ]
    },
    "shape": {
      "title": "Shape",
      "description": "\n\nProperties:\n• boxes (object)",
      "$ref": "#/$defs/misc_shape",
      "defaultSnippets": [
        {
          "label": "Shape Misc",
          "description": "Defines shape configuration.",
          "body": {
            "boxes": ""
          }
        }
      ]
    }
  },
  "required": [
    "description",
    "shape"
  ],
  "$defs": {
    "misc_menu_category": {
      "type": "object",
      "title": "Menu Category Misc",
      "description": "menu_category contains the creative group name and category for this item.",
      "properties": {
        "category": {
          "title": "CreativeItemCategory",
          "description": "Creative category where this item belongs. Defaults to \"none\".",
          "type": "string"
        },
        "group": {
          "title": "Group",
          "description": "The Creative Group that this item belongs to. Group name is limited to 256 characters. The name also must start with a namespace.",
          "type": "string",
          "pattern": "^(?:.)+:(?:.)+$"
        },
        "is_hidden_in_commands": {
          "title": "Is Hidden In Commands",
          "description": "Determines whether or not this item can be used with commands. Commands can use items by default if a category is set.",
          "type": "boolean"
        }
      }
    },
    "misc_description": {
      "type": "object",
      "title": "Description Misc",
      "description": "Contains the required identifier for the item. May contain optional fields like menu_category.",
      "properties": {
        "identifier": {
          "title": "Identifier",
          "description": "Unique name for the item that must include a namespace and must not use the Minecraft namespace unless overriding a Vanilla item.",
          "type": "object"
        },
        "menu_category": {
          "title": "Menu Category",
          "description": "menu_category contains the creative group name and category for this item.\n\nProperties:\n• category (string)\n• group (string)\n• is_hidden_in_commands (boolean)",
          "$ref": "#/$defs/misc_menu_category",
          "defaultSnippets": [
            {
              "label": "Menu Category Misc",
              "description": "menu_category contains the creative group name and category for this item.",
              "body": {
                "category": "",
                "group": "",
                "is_hidden_in_commands": true
              }
            }
          ]
        }
      },
      "required": [
        "identifier"
      ]
    },
    "misc_box": {
      "type": "object",
      "title": "Box Misc",
      "description": "Defines box configuration.",
      "properties": {
        "max": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            {
              "description": "\n\nProperties:\n• x (float)\n• y (float)\n• z (float)",
              "type": "object",
              "properties": {
                "x": {
                  "title": "X",
                  "type": "number"
                },
                "y": {
                  "title": "Y",
                  "type": "number"
                },
                "z": {
                  "title": "Z",
                  "type": "number"
                }
              },
              "defaultSnippets": [
                {
                  "label": "Max (object)",
                  "description": "Use Max as an object",
                  "body": {
                    "x": 0,
                    "y": 0,
                    "z": 0
                  }
                }
              ]
            }
          ],
          "title": "Max",
          "defaultSnippets": [
            {
              "label": "Max (object)",
              "description": "Use Max as an object",
              "body": {
                "x": 0,
                "y": 0,
                "z": 0
              }
            }
          ]
        },
        "min": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            {
              "description": "\n\nProperties:\n• x (float)\n• y (float)\n• z (float)",
              "type": "object",
              "properties": {
                "x": {
                  "title": "X",
                  "type": "number"
                },
                "y": {
                  "title": "Y",
                  "type": "number"
                },
                "z": {
                  "title": "Z",
                  "type": "number"
                }
              },
              "defaultSnippets": [
                {
                  "label": "Min (object)",
                  "description": "Use Min as an object",
                  "body": {
                    "x": 0,
                    "y": 0,
                    "z": 0
                  }
                }
              ]
            }
          ],
          "title": "Min",
          "defaultSnippets": [
            {
              "label": "Min (object)",
              "description": "Use Min as an object",
              "body": {
                "x": 0,
                "y": 0,
                "z": 0
              }
            }
          ]
        }
      },
      "required": [
        "max",
        "min"
      ]
    },
    "misc_shape": {
      "type": "object",
      "title": "Shape Misc",
      "description": "Defines shape configuration.",
      "properties": {
        "boxes": {
          "title": "Boxes",
          "description": "\n\nProperties:\n• max\n• min",
          "$ref": "#/$defs/misc_box",
          "defaultSnippets": [
            {
              "label": "Box Misc",
              "description": "Defines box configuration.",
              "body": {
                "max": "",
                "min": ""
              }
            }
          ],
          "minLength": 1
        }
      },
      "required": [
        "boxes"
      ]
    }
  }
}