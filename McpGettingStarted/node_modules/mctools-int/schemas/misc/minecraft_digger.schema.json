{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/misc/minecraft_digger.form.json",
  "title": "Minecraft Digger Misc",
  "description": "Digger item component specifies how quickly this item can dig specific blocks.",
  "type": "object",
  "properties": {
    "destroy_speeds": {
      "title": "Destroy Speeds",
      "description": "A list of blocks to dig with correlating speeds of digging.\n\nProperties:\n• block ({ name, states, tags })\n• speed (int)",
      "$ref": "#/$defs/misc_blockinfo",
      "defaultSnippets": [
        {
          "label": "BlockInfo Misc",
          "description": "Defines blockinfo configuration.",
          "body": {
            "block": "",
            "speed": 0
          }
        }
      ]
    },
    "use_efficiency": {
      "title": "Use Efficiency",
      "description": "Determines whether this item should be impacted if the efficiency enchantment is applied to it.",
      "type": "boolean"
    }
  },
  "$defs": {
    "misc_blockinfo": {
      "type": "object",
      "title": "BlockInfo Misc",
      "description": "Defines blockinfo configuration.",
      "properties": {
        "block": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "name": {
                  "title": "Name",
                  "type": "string"
                },
                "states": {
                  "anyOf": [
                    {
                      "type": "integer"
                    },
                    {
                      "type": "string"
                    },
                    {
                      "type": "boolean"
                    }
                  ],
                  "title": "States"
                },
                "tags": {
                  "title": "Tags",
                  "type": "string"
                }
              }
            },
            {
              "type": "string"
            },
            {
              "type": "object"
            }
          ],
          "title": "Block",
          "description": "Block to be dug.\n\nProperties:\n• name (string)\n• states (int)\n• tags (string)"
        },
        "speed": {
          "title": "Speed",
          "description": "Digging speed for the correlating block(s).",
          "type": "integer"
        }
      },
      "required": [
        "block",
        "speed"
      ]
    }
  }
}