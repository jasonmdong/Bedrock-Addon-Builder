{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/misc/traits.form.json",
  "title": "Traits Misc",
  "description": "Defines traits configuration.",
  "type": "object",
  "properties": {
    "minecraft:placement_direction": {
      "title": "Minecraft Placement Direction",
      "description": "\n\nProperties:\n• enabled_states (string[])\n• y_rotation_offset (float)",
      "$ref": "#/$defs/misc_placement_direction",
      "defaultSnippets": [
        {
          "label": "Placement Direction Misc",
          "description": "Defines placement direction configuration.",
          "body": {
            "enabled_states": "",
            "y_rotation_offset": 0
          }
        }
      ]
    },
    "minecraft:placement_position": {
      "title": "Minecraft Placement Position",
      "description": "\n\nProperties:\n• enabled_states (string[])",
      "$ref": "#/$defs/misc_placement_position",
      "defaultSnippets": [
        {
          "label": "Placement Position Misc",
          "description": "Defines placement position configuration.",
          "body": {
            "enabled_states": ""
          }
        }
      ]
    }
  },
  "$defs": {
    "misc_placement_direction": {
      "type": "object",
      "title": "Placement Direction Misc",
      "description": "Defines placement direction configuration.",
      "properties": {
        "enabled_states": {
          "title": "Enabled States",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "y_rotation_offset": {
          "title": "y Rotation Offset",
          "type": "number"
        }
      },
      "required": [
        "enabled_states"
      ]
    },
    "misc_placement_position": {
      "type": "object",
      "title": "Placement Position Misc",
      "description": "Defines placement position configuration.",
      "properties": {
        "enabled_states": {
          "title": "Enabled States",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "enabled_states"
      ]
    }
  }
}