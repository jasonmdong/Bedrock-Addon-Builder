  "properties": {
    "conditions": {
      "title": "Conditions",
      "description": "\n\nProperties:\n• minecraft:biome_filter ({ domain, operator, subject, ... })\n• minecraft:brightness_filter (object)\n• minecraft:delay_filter (object)\n• minecraft:density_limit (object)\n• minecraft:difficulty_filter (object)\n• minecraft:disallow_spawns_in_bubble (object)\n• minecraft:distance_filter (object)\n• minecraft:height_filter (object)\n• ... and 16 more properties",
