{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/misc/spawn_permutetype.form.json",
  "title": "Spawn PermuteType Misc",
  "description": "Defines spawn permutetype settings.",
  "type": "object",
  "properties": {
    "entity_type": {
      "title": "Entity Type",
      "description": "Permutation to spawn when selected",
      "type": "object"
    },
    "min_guaranteed": {
      "title": "Min Guaranteed",
