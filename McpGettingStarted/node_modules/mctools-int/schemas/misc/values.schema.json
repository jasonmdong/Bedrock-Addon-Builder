{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/misc/values.form.json",
  "title": "Values Misc",
  "description": "Defines values configuration.",
  "type": "object",
  "properties": {
    "values": {
      "title": "Values",
      "description": "\n\nProperties:\n• max (int)\n• min (int)",
      "$ref": "#/$defs/misc_range",
      "defaultSnippets": [
        {
          "label": "Range Misc",
          "description": "Defines range configuration.",
          "body": {
            "max": 0,
            "min": 0
          }
        }
      ]
    }
  },
  "required": [
    "values"
  ],
  "$defs": {
    "misc_range": {
      "type": "object",
      "title": "Range Misc",
      "description": "Defines range configuration.",
      "properties": {
        "max": {
          "title": "Max",
          "type": "integer"
        },
        "min": {
          "title": "Min",
          "type": "integer"
        }
      },
      "required": [
        "max",
        "min"
      ]
    }
  }
}