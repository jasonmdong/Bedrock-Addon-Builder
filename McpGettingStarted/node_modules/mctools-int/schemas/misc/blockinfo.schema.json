{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/misc/blockinfo.form.json",
  "title": "BlockInfo Misc",
  "description": "Defines blockinfo configuration.",
  "type": "object",
  "properties": {
    "block": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "name": {
              "title": "Name",
              "type": "string"
            },
            "states": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "string"
                },
                {
                  "type": "boolean"
                }
              ],
              "title": "States"
            },
            "tags": {
              "title": "Tags",
              "type": "string"
            }
          }
        },
        {
          "type": "string"
        },
        {
          "type": "object"
        }
      ],
      "title": "Block",
      "description": "Block to be dug.\n\nProperties:\n• name (string)\n• states (int)\n• tags (string)"
    },
    "speed": {
      "title": "Speed",
      "description": "Digging speed for the correlating block(s).",
      "type": "integer"
    }
  },
  "required": [
    "block",
    "speed"
  ]
}