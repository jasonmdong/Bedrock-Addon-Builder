{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/misc/dimension.form.json",
  "title": "Dimension Misc",
  "description": "Defines dimension configuration.",
  "type": "object",
  "properties": {
    "components": {
      "title": "Components",
      "description": "\n\nProperties:\n• minecraft:dimension_bounds (object)\n• minecraft:generation (object)",
      "$ref": "#/$defs/misc_components",
      "defaultSnippets": [
        {
          "label": "Components Misc",
          "description": "Defines components configuration.",
          "body": {
            "minecraft:generation": ""
          }
        }
      ]
    },
    "description": {
      "title": "Description",
      "description": "\n\nProperties:\n• identifier (object)\n• menu_category (object)",
      "$ref": "#/$defs/misc_description",
      "defaultSnippets": [
        {
          "label": "Description Misc",
          "description": "Contains the required identifier for the item. May contain optional fields like menu_category.",
          "body": {
            "identifier": ""
          }
        }
      ]
    }
  },
  "required": [
    "components",
    "description"
  ],
  "$defs": {
    "misc_bounds": {
      "type": "object",
      "title": "Bounds Misc",
      "description": "Defines bounds configuration.",
      "properties": {
        "max": {
          "title": "Max",
          "type": "integer",
          "minimum": -512,
          "maximum": 512
        },
        "min": {
          "title": "Min",
          "type": "integer",
          "minimum": -512,
          "maximum": 512
        }
      },
      "required": [
        "max",
        "min"
      ]
    },
    "misc_generation": {
      "type": "object",
      "title": "Generation Misc",
      "description": "Defines generation configuration.",
      "properties": {
        "generator_type": {
          "title": "Generator Type",
          "type": "string"
        }
      },
      "required": [
        "generator_type"
      ]
    },
    "misc_components": {
      "type": "object",
      "title": "Components Misc",
      "description": "Defines components configuration.",
      "properties": {
        "minecraft:dimension_bounds": {
          "title": "Minecraft Dimension Bounds",
          "description": "\n\nProperties:\n• max (int)\n• min (int)",
          "$ref": "#/$defs/misc_bounds",
          "defaultSnippets": [
            {
              "label": "Bounds Misc",
              "description": "Defines bounds configuration.",
              "body": {
                "max": 0,
                "min": 0
              }
            }
          ]
        },
        "minecraft:generation": {
          "title": "Minecraft Generation",
          "description": "\n\nProperties:\n• generator_type (string)",
          "$ref": "#/$defs/misc_generation",
          "defaultSnippets": [
            {
              "label": "Generation Misc",
              "description": "Defines generation configuration.",
              "body": {
                "generator_type": ""
              }
            }
          ]
        }
      },
      "required": [
        "minecraft:generation"
      ]
    },
    "misc_menu_category": {
      "type": "object",
      "title": "Menu Category Misc",
      "description": "menu_category contains the creative group name and category for this item.",
      "properties": {
        "category": {
          "title": "CreativeItemCategory",
          "description": "Creative category where this item belongs. Defaults to \"none\".",
          "type": "string"
        },
        "group": {
          "title": "Group",
          "description": "The Creative Group that this item belongs to. Group name is limited to 256 characters. The name also must start with a namespace.",
          "type": "string",
          "pattern": "^(?:.)+:(?:.)+$"
        },
        "is_hidden_in_commands": {
          "title": "Is Hidden In Commands",
          "description": "Determines whether or not this item can be used with commands. Commands can use items by default if a category is set.",
          "type": "boolean"
        }
      }
    },
    "misc_description": {
      "type": "object",
      "title": "Description Misc",
      "description": "Contains the required identifier for the item. May contain optional fields like menu_category.",
      "properties": {
        "identifier": {
          "title": "Identifier",
          "description": "Unique name for the item that must include a namespace and must not use the Minecraft namespace unless overriding a Vanilla item.",
          "type": "object"
        },
        "menu_category": {
          "title": "Menu Category",
          "description": "menu_category contains the creative group name and category for this item.\n\nProperties:\n• category (string)\n• group (string)\n• is_hidden_in_commands (boolean)",
          "$ref": "#/$defs/misc_menu_category",
          "defaultSnippets": [
            {
              "label": "Menu Category Misc",
              "description": "menu_category contains the creative group name and category for this item.",
              "body": {
                "category": "",
                "group": "",
                "is_hidden_in_commands": true
              }
            }
          ]
        }
      },
      "required": [
        "identifier"
      ]
    }
  }
}