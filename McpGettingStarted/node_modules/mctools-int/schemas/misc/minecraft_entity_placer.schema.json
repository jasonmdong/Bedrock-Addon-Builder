{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/misc/minecraft_entity_placer.form.json",
  "title": "Minecraft Entity Placer Misc",
  "description": "The entity_placer item component specifies the blocks that the item can be placed on.",
  "type": "object",
  "properties": {
    "dispense_on": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "title": "Name",
                "type": "string"
              },
              "states": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "string"
                  },
                  {
                    "type": "boolean"
                  }
                ],
                "title": "States"
              },
              "tags": {
                "title": "Tags",
                "type": "string"
              }
            }
          }
        },
        {
          "type": "string"
        },
        {
          "type": "object"
        }
      ],
      "title": "Dispense On",
      "description": "List of block descriptors of the blocks that this item can be dispensed on. If left empty, all blocks will be allowed.\n\nProperties:\n• name (string)\n• states (int)\n• tags (string)"
    },
    "entity": {
      "title": "Entity",
      "description": "The entity to be placed in the world.",
      "type": "object",
      "pattern": "^(?:\\w+(?:\\.\\w+)*:(?=\\w))?(?:\\w+(?:\\.\\w+)*)(?:<((?:\\w+(?:\\.\\w+)*:(?=\\w))?\\w+(?:\\.\\w+)*)*>)?$"
    },
    "use_on": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "title": "Name",
                "type": "string"
              },
              "states": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "string"
                  },
                  {
                    "type": "boolean"
                  }
                ],
                "title": "States"
              },
              "tags": {
                "title": "Tags",
                "type": "string"
              }
            }
          }
        },
        {
          "type": "string"
        },
        {
          "type": "object"
        }
      ],
      "title": "Use On",
      "description": "List of block descriptors of the blocks that this item can be used on. If left empty, all blocks will be allowed.\n\nProperties:\n• name (string)\n• states (int)\n• tags (string)"
    }
  }
}