{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/misc/uniformintprovider.form.json",
  "title": "UniformIntProvider Misc",
  "description": "Specifies a uniformly distributed integer",
  "type": "object",
  "properties": {
    "max_inclusive": {
      "title": "Max Inclusive",
      "description": "Maximum value (inclusive)",
      "type": "integer"
    },
    "min_inclusive": {
      "title": "Min Inclusive",
      "description": "Minimum value (inclusive)",
      "type": "integer"
    },
    "type": {
      "title": "IntProviderType",
      "type": "string"
    }
  },
  "required": [
    "max_inclusive",
    "min_inclusive",
    "type"
  ]
}