{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/misc/components.form.json",
  "title": "Components Misc",
  "description": "Defines components configuration.",
  "type": "object",
  "properties": {
    "minecraft:dimension_bounds": {
      "title": "Minecraft Dimension Bounds",
      "description": "\n\nProperties:\n• max (int)\n• min (int)",
      "$ref": "#/$defs/misc_bounds",
      "defaultSnippets": [
        {
          "label": "Bounds Misc",
          "description": "Defines bounds configuration.",
          "body": {
            "max": 0,
            "min": 0
          }
        }
      ]
    },
    "minecraft:generation": {
      "title": "Minecraft Generation",
      "description": "\n\nProperties:\n• generator_type (string)",
      "$ref": "#/$defs/misc_generation",
      "defaultSnippets": [
        {
          "label": "Generation Misc",
          "description": "Defines generation configuration.",
          "body": {
            "generator_type": ""
          }
        }
      ]
    }
  },
  "required": [
    "minecraft:generation"
  ],
  "$defs": {
    "misc_bounds": {
      "type": "object",
      "title": "Bounds Misc",
      "description": "Defines bounds configuration.",
      "properties": {
        "max": {
          "title": "Max",
          "type": "integer",
          "minimum": -512,
          "maximum": 512
        },
        "min": {
          "title": "Min",
          "type": "integer",
          "minimum": -512,
          "maximum": 512
        }
      },
      "required": [
        "max",
        "min"
      ]
    },
    "misc_generation": {
      "type": "object",
      "title": "Generation Misc",
      "description": "Defines generation configuration.",
      "properties": {
        "generator_type": {
          "title": "Generator Type",
          "type": "string"
        }
      },
      "required": [
        "generator_type"
      ]
    }
  }
}