{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/misc/randomgrouppoolalias.form.json",
  "title": "RandomGroupPoolAlias Misc",
  "description": "Pool alias for a RandomGroup of aliases",
  "type": "object",
  "properties": {
    "groups": {
      "title": "Groups",
      "description": "Aliases for a RandomGroup\n\nProperties:\n• data (string[])\n• weight (int)",
      "$ref": "#/$defs/misc_weightedrandomitem",
      "defaultSnippets": [
        {
          "label": "WeightedRandomItem Misc",
          "description": "Weighted Random Item",
          "body": {
            "data": "",
            "weight": 0
          }
        }
      ]
    }
  },
  "required": [
    "groups"
  ],
  "$defs": {
    "misc_weightedrandomitem": {
      "type": "object",
      "title": "WeightedRandomItem Misc",
      "description": "Weighted Random Item",
      "properties": {
        "data": {
          "title": "Data",
          "description": "Item's data",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "weight": {
          "title": "Weight",
          "description": "Weight of item",
          "type": "integer"
        }
      },
      "required": [
        "data",
        "weight"
      ]
    }
  }
}