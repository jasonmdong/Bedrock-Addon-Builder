{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/misc/axisalignedlinear.form.json",
  "title": "AxisAlignedLinear Misc",
  "description": "Predicate that evaluates to true if the block is within the distance range along the provided axis and a random number is generated between the chance range.",
  "type": "object",
  "properties": {
    "axis": {
      "title": "PositionalBlockRuleAxis",
      "type": "string"
    },
    "max_chance": {
      "title": "Max Chance",
      "type": "number"
    },
    "max_dist": {
      "title": "Max Dist",
      "type": "integer"
    },
    "min_chance": {
      "title": "Min Chance",
      "type": "number"
    },
    "min_dist": {
      "title": "Min Dist",
      "type": "integer"
    },
    "predicate_type": {
      "title": "PosType",
      "type": "string"
    }
  },
  "required": [
    "predicate_type"
  ]
}