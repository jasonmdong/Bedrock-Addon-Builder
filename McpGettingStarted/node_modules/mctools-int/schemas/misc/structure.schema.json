{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/misc/structure.form.json",
  "title": "Structure Misc",
  "description": "Defines structure configuration.",
  "type": "object",
  "properties": {
    "structure": {
      "title": "Structure",
      "description": "Identifier of the Jigsaw Structure.",
      "type": "object"
    },
    "weight": {
      "title": "Weight",
      "description": "Weight of the Jigsaw Structure in the set. Higher weights are more likely to be selected.",
      "type": "integer",
      "minimum": 1,
      "maximum": 200
    }
  },
  "required": [
    "structure",
    "weight"
  ]
}