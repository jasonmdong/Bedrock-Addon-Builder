{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/misc/tradeitem.form.json",
  "title": "TradeItem Misc",
  "description": "Defines tradeitem configuration.",
  "type": "object",
  "properties": {
    "__DEP_fltrs": {
      "title": "DEP Fltrs",
      "type": "object"
    },
    "__DEP_fnctns": {
      "title": "DEP Fnctns",
      "type": "object"
    },
    "filters": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "domain": {
              "title": "Domain",
              "description": "The domain the test should be performed in.",
              "type": "object"
            },
            "operator": {
              "title": "Operator",
              "description": "The comparison to apply with 'value'.",
              "type": "object"
            },
            "subject": {
              "title": "Subject",
              "description": "The subject of this filter test.",
              "type": "object"
            },
            "test": {
              "title": "Test",
              "description": "The name of the test to apply.",
              "type": "string"
            },
            "value": {
              "title": "Value",
              "description": "The value being compared with the test.",
              "type": "object"
            }
          }
        },
        {
          "type": "object"
        }
      ],
      "title": "Filters",
      "description": "Filters allow data objects to specify test criteria which allows their use. Filters can be defined by a single object of type (Filter Test), an array of tests, collection groups, or a combination of these objects.\n\nProperties:\n• domain (object)\n• operator (object)\n• subject (object)\n• test (string)\n• value (object)"
    },
    "functions": {
      "title": "Functions",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "item": {
      "title": "Item",
      "type": "object"
    },
    "price_multiplier": {
      "title": "Price Multiplier",
      "type": "number"
    },
    "quantity": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "description": "\n\nProperties:\n• max (int)\n• min (int)",
          "type": "object",
          "properties": {
            "max": {
              "title": "Max",
              "type": "integer",
              "minimum": 1
            },
            "min": {
              "title": "Min",
              "type": "integer",
              "minimum": 1
            }
          },
          "defaultSnippets": [
            {
              "label": "Quantity (object)",
              "description": "Use Quantity as an object",
              "body": {
                "max": 0,
                "min": 0
              }
            }
          ]
        }
      ],
      "title": "Quantity",
      "defaultSnippets": [
        {
          "label": "Quantity (object)",
          "description": "Use Quantity as an object",
          "body": {
            "max": 0,
            "min": 0
          }
        }
      ]
    }
  },
  "required": [
    "item"
  ]
}