{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/dimension/bounds.form.json",
  "title": "Dimension Bounds",
  "description": "Defines the minimum and maximum vertical bounds for a dimension.",
  "type": "object",
  "properties": {
    "max": {
      "title": "Max",
      "type": "integer",
      "minimum": -512,
      "maximum": 512
    },
    "min": {
      "title": "Min",
      "type": "integer",
      "minimum": -512,
      "maximum": 512
    }
  },
  "required": [
    "max",
    "min"
  ]
}