{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/command/argument.form.json",
  "title": "Command Argument",
  "description": "Defines a single command argument (name and description) used in command documentation.",
  "type": "object",
  "properties": {
    "name": {
      "title": "Name",
      "type": "string"
    },
    "description": {
      "title": "Description",
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}