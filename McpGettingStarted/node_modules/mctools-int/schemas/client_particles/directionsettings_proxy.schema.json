{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/client_particles/directionsettings_proxy.form.json",
  "title": "Client Particles DirectionSettings Proxy",
  "description": "Controls the initial direction and velocity of emitted particles. Direction settings determine whether particles spray outward from the emitter, inward toward its center, or follow a custom vector defined by Molang expressions. This affects effects like explosions (outward), implosions (inward), or directional streams like breath attacks and water flows.",
  "type": "object",
  "properties": {
    "custom_direction": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        {
          "type": "string"
        },
        {
          "description": "\n\nProperties:\n• expression (string)\n• version (int)",
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "expression": {
                "title": "Expression",
                "type": "string"
              },
              "version": {
                "title": "Version",
                "type": "integer"
              }
            }
          }
        },
        {
          "type": "number"
        }
      ],
      "title": "Custom Direction"
    },
    "min_speed_threshold": {
      "title": "Min Speed Threshold",
      "type": "number",
      "default": 0
    },
    "mode": {
      "title": "Particle Appearance Billboard Direction Settings Mode",
      "type": "string",
      "enum": [
        "custom",
        "derive_from_velocity"
      ]
    }
  },
  "required": [
    "mode"
  ]
}