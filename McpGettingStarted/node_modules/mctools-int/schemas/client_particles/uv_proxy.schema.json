{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/client_particles/uv_proxy.form.json",
  "title": "Client Particles UV Proxy",
  "description": "Controls UV texture mapping and flipbook animation for particles.",
  "type": "object",
  "properties": {
    "flipbook": {
      "title": "Flipbook",
      "description": "\n\nProperties:\n• base_UV [maxLen: 2]\n• frames_per_second (float) = 0\n• loop (boolean) = false\n• max_frame\n• size_UV = [1,1] [maxLen: 2]\n• step_UV = [0,0] [maxLen: 2]\n• stretch_to_lifetime (boolean) = false",
      "$ref": "#/$defs/client_particles_particle_appearance_billboard_flipbook_data",
      "defaultSnippets": [
        {
          "label": "Client Particles Particle Appearance Billboard Flipbook Data",
          "description": "Enables sprite sheet animation for particle billboards, cycling through frames over the particle's lifetime. Configure the texture grid dimensions, animation speed, and whether to loop or stretch timing. Essential for animated particles like animated flames, water splashes with frames, explosion sequences, and any particle using multi-frame textures.",
          "body": {
            "base_UV": "",
            "frames_per_second": 0,
            "loop": false,
            "max_frame": "",
            "size_UV": [
              1,
              1
            ],
            "step_UV": [
              0,
              0
            ],
            "stretch_to_lifetime": false
          }
        }
      ]
    },
    "texture_height": {
      "title": "Texture Height",
      "type": "integer",
      "default": 1
    },
    "texture_width": {
      "title": "Texture Width",
      "type": "integer",
      "default": 1
    },
    "uv": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        {
          "type": "string"
        },
        {
          "description": "\n\nProperties:\n• expression (string)\n• version (int)",
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "expression": {
                "title": "Expression",
                "type": "string"
              },
              "version": {
                "title": "Version",
                "type": "integer"
              }
            }
          }
        },
        {
          "type": "number"
        }
      ],
      "title": "Uv"
    },
    "uv_size": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        {
          "type": "string"
        },
        {
          "description": "\n\nProperties:\n• expression (string)\n• version (int)",
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "expression": {
                "title": "Expression",
                "type": "string"
              },
              "version": {
                "title": "Version",
                "type": "integer"
              }
            }
          }
        },
        {
          "type": "number"
        }
      ],
      "title": "Uv Size"
    }
  },
  "$defs": {
    "client_particles_particle_appearance_billboard_flipbook_data": {
      "type": "object",
      "title": "Client Particles Particle Appearance Billboard Flipbook Data",
      "description": "Enables sprite sheet animation for particle billboards, cycling through frames over the particle's lifetime. Configure the texture grid dimensions, animation speed, and whether to loop or stretch timing. Essential for animated particles like animated flames, water splashes with frames, explosion sequences, and any particle using multi-frame textures.",
      "properties": {
        "base_UV": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            {
              "type": "string"
            },
            {
              "description": "\n\nProperties:\n• expression (string)\n• version (int)",
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "expression": {
                    "title": "Expression",
                    "type": "string"
                  },
                  "version": {
                    "title": "Version",
                    "type": "integer"
                  }
                }
              }
            },
            {
              "type": "number"
            }
          ],
          "title": "Base UV"
        },
        "frames_per_second": {
          "title": "Frames Per Second",
          "type": "number",
          "default": 0
        },
        "loop": {
          "title": "Loop",
          "type": "boolean",
          "default": false
        },
        "max_frame": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            {
              "type": "string"
            },
            {
              "description": "\n\nProperties:\n• expression (string)\n• version (int)",
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "expression": {
                    "title": "Expression",
                    "type": "string"
                  },
                  "version": {
                    "title": "Version",
                    "type": "integer"
                  }
                }
              }
            },
            {
              "type": "number"
            }
          ],
          "title": "Max Frame"
        },
        "size_UV": {
          "title": "Size UV",
          "type": "array",
          "items": {
            "type": "number"
          },
          "minLength": 2,
          "maxLength": 2
        },
        "step_UV": {
          "title": "Step UV",
          "type": "array",
          "items": {
            "type": "number"
          },
          "minLength": 2,
          "maxLength": 2
        },
        "stretch_to_lifetime": {
          "title": "Stretch To Lifetime",
          "type": "boolean",
          "default": false
        }
      },
      "required": [
        "base_UV",
        "max_frame"
      ]
    }
  }
}