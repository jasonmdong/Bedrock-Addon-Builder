{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/resource/sounds.form.json",
  "title": "Sounds",
  "description": "The sounds.json file defines sound events, entity sounds, block sounds, and interactive sounds for a resource pack. This is the legacy sound configuration file; for newer projects, consider using sound_definitions.json instead.",
  "type": "object",
  "properties": {
    "individual_event_sounds": {
      "title": "Individual Event Sounds",
      "description": "Defines individual sound events that can be triggered by various game actions.\n\nProperties:\n• events",
      "type": "object",
      "properties": {
        "events": {
          "title": "Events",
          "description": "A collection of event sound definitions keyed by event name.\n\nProperties:\n• sound (string)\n• volume = 1\n• pitch = 1",
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "sound": {
                "title": "Sound",
                "description": "The sound identifier to play for this event.",
                "type": "string"
              },
              "volume": {
                "title": "Volume",
                "description": "Volume multiplier for this sound. Can be a single value or a range [min, max].",
                "oneOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 2,
                    "maxItems": 2
                  },
                  {
                    "type": "object",
                    "properties": {
                      "min": {
                        "type": "number",
                        "description": "Minimum value of the range"
                      },
                      "max": {
                        "type": "number",
                        "description": "Maximum value of the range"
                      }
                    }
                  }
                ],
                "default": 1
              },
              "pitch": {
                "title": "Pitch",
                "description": "Pitch multiplier for this sound. Can be a single value or a range [min, max].",
