{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/resource/render_controller_set_geometry.form.json",
  "title": "Render Controller Set",
  "description": "Defines geometry selection logic for entity rendering.",
  "type": "object",
  "properties": {
    "render_controllers": {
      "description": "\n\nProperties:\n• geometry (string)\n• arrays ({ geometries })",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "geometry": {
            "title": "Geometry",
            "description": "A name or expression that describes which model to use for this item",
            "type": "string"
          },
          "arrays": {
            "title": "Lists",
            "description": "\n\nProperties:\n• geometries",
            "type": "object",
            "properties": {
              "geometries": {
                "title": "Geometries",
                "description": "Lists of geometries that can be used in selection calculations",
                "type": "object",
                "additionalProperties": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}