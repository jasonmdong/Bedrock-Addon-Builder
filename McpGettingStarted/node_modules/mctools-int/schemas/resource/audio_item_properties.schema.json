{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/resource/audio_item_properties.form.json",
  "title": "Audio Properties",
  "description": "Defines audio volume and weight settings for sound playback.",
  "type": "object",
  "properties": {
    "definitions": {
      "description": "\n\nProperties:\n• sounds",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "sounds": {
            "description": "\n\nProperties:\n• volume (float)\n• weight (int)",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "volume": {
                  "title": "Volume",
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "weight": {
                  "title": "Weight",
                  "type": "integer"
                }
              }
            }
          }
        }
      }
    }
  }
}