{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/item/minecraft_repairable.form.json",
  "title": "Item Repairable",
  "description": "The repairable item component specifies which items can be used to repair this item, along with how much durability is gained.",
  "type": "object",
  "properties": {
    "repair_items": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "description": "\n\nProperties:\n• items (string)\n• repair_amount = {\"expression\":\"\",\"ve",
          "type": "object",
          "properties": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              ],
              "title": "Items",
              "description": "Items that may be used to repair an item."
            },
            "repair_amount": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                {
                  "type": "string"
                },
                {
                  "description": "\n\nProperties:\n• expression (string)\n• version (int)",
                  "type": "object",
                  "additionalProperties": {
                    "type": "object",
                    "properties": {
                      "expression": {
                        "title": "Expression",
                        "type": "string"
                      },
                      "version": {
                        "title": "Version",
                        "type": "integer"
                      }
                    }
                  }
                },
                {
                  "type": "number"
                }
              ],
              "title": "Repair Amount",
              "description": "How much the item is repaired."
            }
          },
          "defaultSnippets": [
            {
              "label": "Repair Items (object)",
              "description": "Use Repair Items as an object",
              "body": {
                "items": "",
                "repair_amount": {
                  "expression": "",
                  "version": -1
                }
              }
            }
          ]
        }
      ],
      "title": "Repair Items",
      "description": "List of repair item entries. Each entry needs to define a list of strings for `items` that can be used for the repair and an optional `repair_amount` for how much durability is gained.",
      "defaultSnippets": [
        {
          "label": "Repair Items (object)",
          "description": "Use Repair Items as an object",
          "body": {
            "items": "",
            "repair_amount": {
              "expression": "",
              "version": -1
            }
          }
        },
        {
          "label": "Repair Items (default)",
          "description": "Use default value: ",
          "body": []
        }
      ]
    }
  }
}