# =============================================================================
# MCT (Minecraft Creator Tools) Docker Image
# =============================================================================
# This Dockerfile builds from an extracted MCT npm package.
#
# USAGE (from the extracted mctools package root):
#   docker build -f docker/Dockerfile -t mct:latest .
#
# Or with docker-compose:
#   cd docker
#   docker-compose up -d
#
# REQUIREMENTS:
# - You must accept the Minecraft EULA by setting the environment variable:
#   MCTOOLS_I_ACCEPT_EULA_AT_MINECRAFTDOTNETSLASHEULA=true
# - See: https://minecraft.net/eula
# =============================================================================

# -----------------------------------------------------------------------------
# Stage 1: Base image with Node.js and system dependencies
# -----------------------------------------------------------------------------
FROM node:22-bookworm-slim AS base

# Install dependencies required by Bedrock Dedicated Server
# - libcurl4: Required by BDS for network operations
# - libssl3: Required for HTTPS/TLS
# - unzip: For extracting BDS zip files
# - ca-certificates: For HTTPS certificate validation
# - curl: For health checks
RUN apt-get update && apt-get install -y --no-install-recommends \
  libcurl4 \
  libssl3 \
  unzip \
  ca-certificates \
  curl \
  && rm -rf /var/lib/apt/lists/*

# -----------------------------------------------------------------------------
# Stage 2: Install MCT from local package files
# -----------------------------------------------------------------------------
FROM base AS runtime

# Set working directory
WORKDIR /app

# Copy package.json first for better layer caching
COPY package.json ./

# Copy all package contents to node_modules location
COPY cli/ ./node_modules/mctools-int/cli/
COPY lib/ ./node_modules/mctools-int/lib/
COPY web/ ./node_modules/mctools-int/web/
COPY data/ ./node_modules/mctools-int/data/
COPY dist/ ./node_modules/mctools-int/dist/
COPY mc/ ./node_modules/mctools-int/mc/
COPY res/ ./node_modules/mctools-int/res/

# Copy package.json to the installed location
COPY package.json ./node_modules/mctools-int/

# Install dependencies
RUN cd node_modules/mctools-int && npm install --omit=dev \
  && npm cache clean --force

# Create a wrapper script to run mct
RUN echo '#!/bin/sh\nnode /app/node_modules/mctools-int/cli/index.js "$@"' > /usr/local/bin/mct \
  && chmod +x /usr/local/bin/mct

# Create directories for persistent data
RUN mkdir -p /data/server /data/worlds /data/cli /data/test \
  && chown -R node:node /data \
  && chown -R node:node /app

# Switch to non-root user
USER node

# -----------------------------------------------------------------------------
# Environment Variables
# -----------------------------------------------------------------------------
# REQUIRED: You must set this to "true" to accept the Minecraft EULA
ENV MCTOOLS_I_ACCEPT_EULA_AT_MINECRAFTDOTNETSLASHEULA="false"

# Server configuration
ENV MCTOOLS_ADMIN_PASSCODE=""
ENV MCTOOLS_UPDATE_PASSCODE=""
ENV MCTOOLS_DISPLAY_PASSCODE=""
ENV MCTOOLS_PORT="6126"
ENV MCTOOLS_SLOT="0"
ENV MCTOOLS_DOMAIN="0.0.0.0"
ENV MCTOOLS_FEATURES="all"
ENV MCTOOLS_TITLE="Minecraft Server"
ENV MCTOOLS_MOTD="A Minecraft Server"
ENV MCTOOLS_DATA_DIR="/data"
ENV MCTOOLS_LOG_VERBOSE="false"

# -----------------------------------------------------------------------------
# Expose Ports
# -----------------------------------------------------------------------------
EXPOSE 6126/tcp
EXPOSE 19132/udp
EXPOSE 19133/udp

# -----------------------------------------------------------------------------
# Health Check
# -----------------------------------------------------------------------------
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD curl -f http://localhost:${MCTOOLS_PORT}/ || exit 1

# -----------------------------------------------------------------------------
# Entrypoint
# -----------------------------------------------------------------------------
COPY docker/docker-entrypoint.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
CMD ["serve"]
